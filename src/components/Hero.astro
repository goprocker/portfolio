---
import { site } from "../data/site";
---

<section class="hero relative overflow-hidden px-5 sm:px-8">
  <div class="hero-grid" aria-hidden="true"></div><div class="hero-sun" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex min-h-[calc(100svh-73px)] max-w-7xl flex-col justify-between py-14 sm:py-20">
    <div class="flex items-center gap-3 scroll-reveal"><span class="h-2.5 w-2.5 animate-pulse rounded-full bg-lime"></span><p class="text-xs font-semibold uppercase tracking-[0.2em] text-text-muted">Available for select projects</p></div>
    <div class="my-14"><p class="scroll-reveal scroll-reveal-delay-1 mb-5 text-sm font-medium uppercase tracking-[0.18em] text-lime">Independent designer & developer</p><h1 class="scroll-reveal scroll-reveal-delay-2 max-w-6xl font-display text-[clamp(3.4rem,9.5vw,9.5rem)] font-black uppercase leading-[0.82] tracking-[-0.075em]">Digital ideas<br />with <span class="hero-outline">real impact.</span></h1></div>
    <div class="grid gap-8 border-t border-border pt-6 md:grid-cols-[1.25fr_.75fr] md:items-end"><p class="scroll-reveal scroll-reveal-delay-3 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg">{site.tagline}. I turn ambitious concepts into clear, memorable experiences for the web.</p><div class="scroll-reveal scroll-reveal-delay-4 flex flex-wrap gap-3 md:justify-end"><a href="/projects" class="button-primary">Explore work <span aria-hidden="true">↘</span></a><a href="/contact" class="button-ghost">Start a project <span aria-hidden="true">↗</span></a></div></div>
  </div>
</section>
