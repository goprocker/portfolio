---
import { PORTFOLIO_DATA } from "../data/portfolio";
---

<div id="view-cli" class="flex flex-col flex-1 font-mono text-xs md:text-sm">
  <!-- Terminal Welcome Message & Banner -->
  <div class="mb-4 space-y-1.5 text-[var(--fg-main)]">
    <div class="text-[var(--accent)] font-bold">
      WELCOME TO GOPINATH'S AI/ML TERMINAL PORTFOLIO v1.0.0
    </div>
    <div class="text-[var(--fg-dim)]">
      Type <span class="text-[var(--fg-bright)] font-bold">help</span> to view available
      commands, or click <span
        class="text-[var(--accent)] cursor-pointer hover:underline"
        onclick="window.switchTuiMode('gui')">[#] GUI Dashboard</span
      > for visual mode.
    </div>
  </div>

  <!-- Terminal Output Buffer -->
  <div id="cli-output" class="flex-1 space-y-4 mb-4">
    <!-- Initial welcome banner output -->
    <div
      class="border-l-2 border-[var(--accent)] pl-3 py-1 bg-[var(--bg-card)] text-[var(--fg-main)]"
    >
      <div class="font-bold text-[var(--fg-bright)]">
        {PORTFOLIO_DATA.developer.name} - {PORTFOLIO_DATA.developer.title}
      </div>
      <div class="text-xs text-[var(--fg-dim)] mt-0.5">
        {PORTFOLIO_DATA.developer.CLI_EMOJI}
        {PORTFOLIO_DATA.developer.status}
      </div>
      <div class="text-xs text-[var(--fg-main)] mt-1">Welcome, <span data-visitor-name class="font-bold text-[var(--fg-bright)]">guest</span>. Thanks for stopping by.</div>
      <div class="text-xs text-[var(--accent)] mt-1 font-bold">
        Type 'about', 'skills', or 'projects' to explore content.
      </div>
    </div>
  </div>

  <!-- CLI Interactive Input Line -->
  <div
    class="flex items-center gap-2 pt-2 border-t border-[var(--border-color)] bg-[var(--bg-main)]"
  >
    <span
      class="text-[var(--accent)] font-bold flex items-center gap-1 select-none"
    >
      <span data-visitor-name class="text-emerald-400">guest</span>@<span
        class="text-[var(--fg-bright)]">gopinath</span
      >:<span class="text-cyan-400">~</span>$
    </span>
    <div class="relative flex-1 flex items-center">
      <input
        id="cli-input"
        aria-label="Terminal Command Input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Type 'about', 'skills', or 'projects'..."
        class="w-full bg-transparent text-[var(--fg-bright)] font-mono focus:outline-none caret-[var(--accent)] py-1 text-xs md:text-sm"
      />
    </div>
  </div>
</div>

<script>
  import { PORTFOLIO_DATA } from "../data/portfolio";
  import { SPOTIFY_CONFIG, getSpotifyActivity } from "../config/spotifyConfig";
  import { GAMES_CONFIG, getLiveGameActivity } from "../config/gamesConfig";
  import {
    ALL_THEMES,
    applyTheme,
    applyCRTConfig,
    CRT_PRESETS,
  } from "../config/themeConfig";
  import type { CRTIntensityLevel } from "../config/themeConfig";
  import {
    playKeypressSound,
    playSuccessSound,
    playErrorSound,
    playBeep,
    toggleSfx,
  } from "../utils/sound";

  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("cli-input") as HTMLInputElement;
    const output = document.getElementById("cli-output");
    if (!input || !output) return;

    let visitorName = sessionStorage.getItem("portfolio_visitor_name") || "guest";
    window.addEventListener("portfolio:visitor-name", ((event: CustomEvent<string>) => { visitorName = event.detail; }) as EventListener);
    let commandHistory: string[] = [];
    let historyIndex = -1;

    const availableCommands = PORTFOLIO_DATA.commands.map((c) => c.name);

    document.getElementById("view-cli")?.addEventListener("click", () => {
      input.focus();
    });

    input.addEventListener("keydown", (e) => {
      if (
        e.key !== "Enter" &&
        e.key !== "Tab" &&
        e.key !== "ArrowUp" &&
        e.key !== "ArrowDown"
      ) {
        playKeypressSound();
      }

      if (e.key === "Tab") {
        e.preventDefault();
        const current = input.value.trim().toLowerCase();
        if (!current) return;

        const matches = availableCommands.filter((c) => c.startsWith(current));
        if (matches.length === 1) {
          input.value = matches[0] + " ";
          playBeep(600, 0.04);
        } else if (matches.length > 1) {
          appendOutput(
            `<div class="text-[var(--fg-dim)]">Possible matches: ${matches.join("  ")}</div>`,
          );
          playBeep(400, 0.04);
        }
        return;
      }

      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          input.value =
            commandHistory[commandHistory.length - 1 - historyIndex];
        }
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value =
            commandHistory[commandHistory.length - 1 - historyIndex];
        } else if (historyIndex === 0) {
          historyIndex = -1;
          input.value = "";
        }
        return;
      }

      if (e.key === "Enter") {
        const rawCmd = input.value.trim();
        if (!rawCmd) return;

        commandHistory.push(rawCmd);
        historyIndex = -1;

        appendEcho(rawCmd);
        input.value = "";

        processCommand(rawCmd);
      }
    });

    function appendEcho(cmd: string) {
      if (!output) return;
      const echoDiv = document.createElement("div");
      echoDiv.className =
        "flex items-center gap-2 font-mono text-xs md:text-sm font-bold mt-3";
      echoDiv.innerHTML = `
        <span class="text-[var(--accent)]"><span class="text-emerald-400">${escapeHtml(visitorName)}</span>@<span class="text-[var(--fg-bright)]">gopinath</span>:<span class="text-cyan-400">~</span>$</span>
        <span class="text-[var(--fg-bright)]">${escapeHtml(cmd)}</span>
      `;
      output.appendChild(echoDiv);
    }

    function appendOutput(html: string) {
      if (!output) return;
      const outDiv = document.createElement("div");
      outDiv.className = "mt-1 text-xs md:text-sm font-mono leading-relaxed";
      outDiv.innerHTML = html;
      output.appendChild(outDiv);

      window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
    }

    function processCommand(rawCmd: string) {
      const parts = rawCmd.split(" ").filter(Boolean);
      const cmd = parts[0].toLowerCase();
      const args = parts.slice(1);
      const flag = (args[0] || "").toLowerCase();

      switch (cmd) {
        case "help":
        case "man":
          playSuccessSound();
          renderHelp();
          break;

        case "about":
        case "bio":
          playSuccessSound();
          renderAbout();
          break;

        case "skills":
        case "skill":
          playSuccessSound();
          renderSkills(flag === "--list" || flag === "-l");
          break;

        case "collabs":
        case "collaborations":
        case "projects":
        case "project":
          playSuccessSound();
          renderCollabs(flag === "--featured" || flag === "-f");
          break;

        case "portfolio":
        case "portfolio.exe":
          playSuccessSound();
          handlePortfolio(args[0]);
          break;

        case "dir":
          playSuccessSound();
          renderDir();
          break;

        case "type":
          playSuccessSound();
          handleType(args[0]);
          break;

        case "cd":
          playSuccessSound();
          handleCd(args[0]);
          break;

        case "github":
        case "gh":
          playSuccessSound();
          renderGithub();
          break;

        case "status":
          playSuccessSound();
          renderStatus();
          break;

        case "coffee":
        case "tea":
          renderCoffee();
          break;

        case "hire-me":
        case "hire":
        case "hireme":
          renderHireMe();
          break;

        case "rm":
          handleRm(args.join(" "));
          break;

        case "deploy":
          handleDeploy(args.join(" "));
          break;

        case "experience":
        case "work":
          playSuccessSound();
          renderExperience();
          break;

        case "internships":
        case "internship":
          playSuccessSound();
          renderInternships();
          break;

        case "events":
        case "event":
          playSuccessSound();
          renderEvents();
          break;

        case "ambassadors":
        case "ambassador":
          playSuccessSound();
          renderAmbassadors();
          break;

        case "companies":
        case "organizations":
        case "orgs":
          playSuccessSound();
          renderOrganizations();
          break;

        case "principles":
        case "philosophy":
        case "values":
          playSuccessSound();
          renderPrinciples();
          break;

        case "focus":
        case "current":
        case "now":
          playSuccessSound();
          renderFocus();
          break;

        case "resume":
        case "cv":
        case "download":
          playSuccessSound();
          renderResume();
          break;

        case "games":
        case "game":
        case "gaming":
        case "activity":
          playSuccessSound();
          renderGames();
          break;

        case "quote":
        case "fortune":
        case "motivate":
          playSuccessSound();
          renderQuote();
          break;

        case "whoami":
          playSuccessSound();
          renderWhoami();
          break;

        case "tree":
          playSuccessSound();
          renderTree();
          break;

        case "date":
        case "time":
        case "clock":
          playSuccessSound();
          renderDate();
          break;

        case "ping":
          playSuccessSound();
          renderPing(args[0]);
          break;

        case "echo":
          playSuccessSound();
          renderEcho(args.join(" "));
          break;

        case "history":
          playSuccessSound();
          renderHistory();
          break;

        case "banner":
        case "ascii":
          playSuccessSound();
          renderBanner();
          break;

        case "repo":
        case "source":
        case "code":
          playSuccessSound();
          renderRepo();
          break;

        case "weather":
          playSuccessSound();
          renderWeather();
          break;

        case "sudo":
          if (args[0] && (args[0].toLowerCase() === "hire-me" || args[0].toLowerCase() === "hire" || args[0].toLowerCase() === "hireme")) {
            renderHireMe();
          } else {
            renderSudo(args.join(" "));
          }
          break;

        case "cat":
          playSuccessSound();
          handleType(args[0]);
          break;

        case "ls":
          playSuccessSound();
          appendOutput(`
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono py-1">
              <span class="text-yellow-400 font-bold">📄 about.txt</span>
              <span class="text-yellow-400 font-bold">📄 bio.txt</span>
              <span class="text-emerald-400 font-bold">⚙️ skills.sh</span>
              <span class="text-purple-400 font-bold">🚀 projects.md</span>
              <span class="text-cyan-400 font-bold">💼 experience.md</span>
              <span class="text-emerald-400 font-bold">🧪 internships.md</span>
              <span class="text-purple-400 font-bold">🎤 events.md</span>
              <span class="text-yellow-400 font-bold">🎓 ambassadors.md</span>
              <span class="text-blue-400 font-bold">🏢 companies.txt</span>
              <span class="text-purple-400 font-bold">📜 principles.md</span>
              <span class="text-cyan-400 font-bold">⚡ focus.txt</span>
              <span class="text-emerald-400 font-bold">📑 resume.txt</span>
              <span class="text-red-400 font-bold">✉️ contact.txt</span>
              <span class="text-emerald-400 font-bold">⚡ portfolio.exe</span>
            </div>
          `);
          break;

        case "neofetch":
        case "fetch":
          playSuccessSound();
          renderNeofetch();
          break;

        case "contact":
        case "mail":
          playSuccessSound();
          renderContact();
          break;

        case "links":
        case "socials":
        case "urls":
          playSuccessSound();
          renderLinks();
          break;

        case "theme":
          if (args[0]) {
            const themeInput = args[0].toLowerCase();
            const matchedTheme = ALL_THEMES.find((t) => t.id === themeInput);
            if (matchedTheme) {
              applyTheme(matchedTheme.id);
              localStorage.setItem("tui_theme", matchedTheme.id);
              const selectEl = document.getElementById(
                "theme-select",
              ) as HTMLSelectElement;
              if (selectEl) selectEl.value = matchedTheme.id;
              playSuccessSound();
              appendOutput(
                `<div class="text-emerald-400 font-bold">Theme set to ${matchedTheme.emoji} [${matchedTheme.name.toUpperCase()}].</div>`,
              );
            } else {
              playErrorSound();
              const themeList = ALL_THEMES.map((t) => t.id).join(" | ");
              appendOutput(
                `<div class="text-red-400">Invalid theme. Available options: ${themeList}</div>`,
              );
            }
          } else {
            const themeList = ALL_THEMES.map((t) => t.id).join(" | ");
            appendOutput(
              `<div class="text-yellow-400">Usage: theme <${themeList}></div>`,
            );
          }
          break;

        case "spotify":
        case "nowplaying":
        case "np":
          playSuccessSound();
          renderSpotify();
          break;

        case "matrix":
          playSuccessSound();
          const win = window as unknown as {
            toggleMatrix?: (f?: boolean) => void;
          };
          if (win.toggleMatrix) win.toggleMatrix(true);
          appendOutput(
            `<div class="text-emerald-400 font-bold">Matrix rain canvas enabled. Press [ESC] to exit.</div>`,
          );
          break;

        case "crt":
          document.getElementById("toggle-crt-btn")?.click();
          appendOutput(
            `<div class="text-cyan-400">Toggled CRT scanlines overlay.</div>`,
          );
          break;

        case "sfx":
          const enabled = toggleSfx();
          appendOutput(
            `<div class="text-cyan-400">SFX Sound feedback: ${enabled ? "ENABLED 🔊" : "MUTED 🔇"}</div>`,
          );
          break;

        case "clear":
        case "cls":
          if (output) output.innerHTML = "";
          playBeep(800, 0.03);
          break;

        case "gui":
          const switchFn = (
            window as unknown as { switchTuiMode?: (m: string) => void }
          ).switchTuiMode;
          if (switchFn) switchFn("gui");
          break;

        default:
          playErrorSound();
          appendOutput(`
            <div class="text-red-400">
              '${escapeHtml(cmd)}' is not recognized as an internal or external command.
              Type <span class="text-[var(--fg-bright)] underline cursor-pointer" onclick="document.getElementById('cli-input').value='help'; document.getElementById('cli-input').dispatchEvent(new KeyboardEvent('keydown', {key:'Enter'}));">help</span> to view available commands.
            </div>
          `);
          break;
      }
    }

    function renderHelp() {
      let html = `
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-3 my-2 font-mono">
          <div class="text-[var(--fg-bright)] font-bold border-b border-[var(--border-color)] pb-1 mb-2">AVAILABLE TERMINAL COMMANDS</div>
          <div class="space-y-1.5 text-xs">
      `;
      PORTFOLIO_DATA.commands.forEach((c) => {
        html += `
          <div class="grid grid-cols-12 gap-2">
            <span class="col-span-3 text-[var(--accent)] font-bold">${c.name}</span>
            <span class="col-span-9 text-[var(--fg-main)]">${c.desc} <span class="text-[var(--fg-dim)] text-[10px]">(${c.usage})</span></span>
          </div>
        `;
      });
      html += `</div></div>`;
      appendOutput(html);
    }

    function renderDir() {
      appendOutput(`
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-3 my-2 font-mono text-xs space-y-1">
          <div class="text-[var(--fg-dim)]">Directory: <span class="text-[var(--fg-bright)] font-bold">C:\\Portfolio</span></div>
          <pre class="text-[var(--fg-main)] text-xs leading-relaxed whitespace-pre font-mono">
Mode                 LastWriteTime         Length Name
----                 -------------         ------ ----
<span class="text-[var(--accent)] font-bold">d-----</span>        30-08-2026     19:42                <span class="text-yellow-400 font-bold">about</span>
<span class="text-[var(--accent)] font-bold">d-----</span>        30-08-2026     19:42                <span class="text-yellow-400 font-bold">projects</span>
<span class="text-[var(--accent)] font-bold">d-----</span>        30-08-2026     19:42                <span class="text-yellow-400 font-bold">skills</span>
<span class="text-[var(--accent)] font-bold">d-----</span>        30-08-2026     19:42                <span class="text-yellow-400 font-bold">experience</span>
<span class="text-[var(--accent)] font-bold">d-----</span>        30-08-2026     19:42                <span class="text-yellow-400 font-bold">contact</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           1024 <span class="text-yellow-400">about.txt</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           2048 <span class="text-yellow-400">bio.txt</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           1536 <span class="text-emerald-400">skills.sh</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           4096 <span class="text-purple-400">projects.md</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           3072 <span class="text-cyan-400">experience.md</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           2560 <span class="text-purple-400">principles.md</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           1280 <span class="text-cyan-400">focus.txt</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42           2048 <span class="text-emerald-400">resume.txt</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42            512 <span class="text-red-400">contact.txt</span>
<span class="text-[var(--fg-dim)]">-a----</span>        30-08-2026     19:42         104857 <span class="text-emerald-400 font-bold">portfolio.exe</span></pre>
          <div class="text-[10px] text-[var(--fg-dim)] pt-1">Type 'type &lt;file&gt;', 'cd &lt;dir&gt;', or 'portfolio.exe' to inspect.</div>
        </div>
      `);
    }

    function handleCd(targetDir?: string) {
      const dir = (targetDir || "").toLowerCase().trim().replace(/[\\/]/g, "");
      if (!dir || dir === "~" || dir === "portfolio" || dir === "c:" || dir === "..") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Current directory: <span class="font-bold">C:\\Portfolio</span></div>`);
        return;
      }
      if (dir === "about") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Navigated to <span class="font-bold">C:\\Portfolio\\about</span>:</div>`);
        renderAbout();
      } else if (dir === "projects" || dir === "collabs") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Navigated to <span class="font-bold">C:\\Portfolio\\projects</span>:</div>`);
        renderCollabs();
      } else if (dir === "skills") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Navigated to <span class="font-bold">C:\\Portfolio\\skills</span>:</div>`);
        renderSkills();
      } else if (dir === "experience" || dir === "work") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Navigated to <span class="font-bold">C:\\Portfolio\\experience</span>:</div>`);
        renderExperience();
      } else if (dir === "contact") {
        appendOutput(`<div class="text-cyan-400 font-mono text-xs my-1">Navigated to <span class="font-bold">C:\\Portfolio\\contact</span>:</div>`);
        renderContact();
      } else {
        playErrorSound();
        appendOutput(`<div class="text-red-400 font-mono text-xs my-1">The system cannot find the path specified: ${escapeHtml(targetDir || "")}. Available directories: about, projects, skills, experience, contact.</div>`);
      }
    }

    function handleType(fileName?: string) {
      const file = (fileName || "").toLowerCase().trim();
      if (file === "about.txt" || file === "bio.txt" || file === "about") renderAbout();
      else if (file === "skills.sh" || file === "skills.txt" || file === "skills") renderSkills();
      else if (file === "collabs.md" || file === "projects.md" || file === "projects.txt" || file === "projects") renderCollabs();
      else if (file === "experience.md" || file === "experience.txt" || file === "experience") renderExperience();
      else if (file === "internships.md" || file === "internships") renderInternships();
      else if (file === "events.md" || file === "events") renderEvents();
      else if (file === "ambassadors.md" || file === "ambassadors") renderAmbassadors();
      else if (file === "companies.txt" || file === "companies") renderOrganizations();
      else if (file === "principles.md" || file === "principles.txt" || file === "principles") renderPrinciples();
      else if (file === "focus.txt" || file === "status.txt" || file === "focus") renderFocus();
      else if (file === "resume.txt" || file === "cv.txt" || file === "resume") renderResume();
      else if (file === "contact.txt" || file === "contact") renderContact();
      else {
        playErrorSound();
        appendOutput(
          `<div class="text-yellow-400 text-xs font-mono">Usage: type &lt;about.txt | bio.txt | skills.sh | projects.md | experience.md | principles.md | focus.txt | resume.txt | contact.txt&gt;</div>`,
        );
      }
    }

    function handlePortfolio(flag?: string) {
      const f = (flag || "").toLowerCase().trim();
      if (f === "--about" || f === "-a") {
        renderAbout();
      } else if (f === "--skills" || f === "-s") {
        renderSkills();
      } else if (f === "--projects" || f === "-p") {
        renderCollabs();
      } else if (f === "--experience" || f === "-e") {
        renderExperience();
      } else if (f === "--contact" || f === "-c") {
        renderContact();
      } else {
        appendOutput(`
          <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 my-2 font-mono text-xs space-y-2">
            <div class="text-[var(--fg-dim)] text-[11px]">Microsoft Windows [Version 11.0.26100.1]</div>
            <div class="text-[var(--fg-bright)] font-bold">C:\\Users\\Gopinath&gt; portfolio.exe</div>
            <div class="space-y-0.5 text-xs text-[var(--fg-main)] pt-1">
              <div>Initializing portfolio...</div>
              <div>Loading projects........... <span class="text-emerald-400 font-bold">[OK]</span></div>
              <div>Loading experience......... <span class="text-emerald-400 font-bold">[OK]</span></div>
              <div>Loading skills............. <span class="text-emerald-400 font-bold">[OK]</span></div>
              <div>Loading agentic engine..... <span class="text-emerald-400 font-bold">[OK]</span></div>
            </div>
            <div class="pt-2 border-t border-[var(--border-color)] text-xs">
              <span class="text-emerald-400 font-bold">Welcome, ${escapeHtml(visitorName)}.</span>
              <div class="text-[var(--fg-dim)] mt-1">Available flags: <span class="text-[var(--accent)] font-bold">--about</span>, <span class="text-[var(--accent)] font-bold">--skills</span>, <span class="text-[var(--accent)] font-bold">--projects</span>, <span class="text-[var(--accent)] font-bold">--experience</span>, <span class="text-[var(--accent)] font-bold">--contact</span></div>
            </div>
          </div>
        `);
      }
    }

    function renderGithub() {
      const gh = PORTFOLIO_DATA.developer.github;
      window.open(gh, "_blank");
      appendOutput(`
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-3 my-2 font-mono text-xs space-y-1.5">
          <div class="text-emerald-400 font-bold flex items-center gap-2">
            <span>🐙</span>
            <span>Opening GitHub in new window...</span>
