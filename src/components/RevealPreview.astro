---
// Vengeance UI image-reveal-list, adapted: hovering a [data-reveal-row] floats a preview card
// (logo or monogram, role, period, description) that trails the cursor with a little lag and tilt.
---

<aside class="rv-card glass" id="rv-card" aria-hidden="true">
  <div class="rv-head">
    <span class="rv-logo"><img alt="" /><b></b></span>
    <span class="min-w-0"><span class="rv-org"></span><span class="rv-period"></span></span>
  </div>
  <p class="rv-role"></p>
  <p class="rv-desc"></p>
</aside>

<style>
  :global(.os.rv-host) { min-height: 0; background: none; overflow: visible; }
  .rv-card { position: fixed; left: 0; top: 0; z-index: 90; width: 300px; padding: 14px 16px; border-radius: 16px; border: 1px solid var(--hair); pointer-events: none; opacity: 0; transform-origin: 0 0; transition: opacity 0.25s, scale 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); scale: 0.85; box-shadow: 0 24px 50px -24px rgb(20 30 70 / 0.55); }
  .rv-card.on { opacity: 1; scale: 1; }
  .rv-head { display: flex; align-items: center; gap: 10px; }
  .rv-logo { width: 38px; height: 38px; flex-shrink: 0; display: grid; place-items: center; border-radius: 10px; overflow: hidden; background: var(--ink); color: var(--desk); font: 700 16px "Geist", sans-serif; }
  .rv-logo img { width: 100%; height: 100%; object-fit: cover; background: #fff; }
  .rv-logo img:not([src]), .rv-logo img[src=""] { display: none; }
  .rv-logo:has(img[src]:not([src=""])) b { display: none; }
  .rv-org { display: block; font: 700 14px "Geist", sans-serif; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rv-period { display: block; font: 500 10.5px "Geist Mono", monospace; color: var(--muted); }
  .rv-role { margin-top: 10px; font: 600 12.5px "Geist", sans-serif; color: var(--blue); }
  .rv-desc { margin-top: 4px; font-size: 12.5px; line-height: 1.5; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .rv-desc:empty { display: none; }
  @media (hover: none), (max-width: 900px) { .rv-card { display: none; } }
</style>

<script>
  const card = document.getElementById("rv-card");
  if (card && window.matchMedia("(hover: hover)").matches) {
    // An ancestor (.os) creates a containing block, which would make position: fixed scroll with the page.
    // A tiny .os host on <body> keeps the theme tokens, mirroring the light/dark mode.
    const src = card.closest<HTMLElement>(".os");
    const host = document.createElement("div");
    host.className = "os rv-host";
    document.body.appendChild(host);
    host.appendChild(card);
    const sync = () => { if (src?.dataset.mode) host.dataset.mode = src.dataset.mode; };
    sync();
    if (src) new MutationObserver(sync).observe(src, { attributes: true, attributeFilter: ["data-mode"] });
    const q = <T extends HTMLElement>(s: string) => card.querySelector<T>(s)!;
    const img = q<HTMLImageElement>(".rv-logo img");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, active: HTMLElement | null = null;

    const tick = () => {
      x += (tx - x) * (reduce ? 1 : 0.16);
      y += (ty - y) * (reduce ? 1 : 0.16);
      const tilt = reduce ? 0 : Math.max(-8, Math.min(8, (tx - x) * 0.12));
      card.style.translate = `${x}px ${y}px`;
      card.style.rotate = `${tilt}deg`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(tick) : 0;
    };
    const place = (e: PointerEvent) => {
      const w = card.offsetWidth, h = card.offsetHeight;
      tx = e.clientX + 24 + w > innerWidth ? e.clientX - w - 24 : e.clientX + 24;
      ty = Math.min(e.clientY + 18, innerHeight - h - 12);
      if (!raf) raf = requestAnimationFrame(tick);
    };

    document.addEventListener("pointerover", (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>("[data-reveal-row]");
      if (row === active) return;
      active = row;
      if (!row) { card.classList.remove("on"); return; }
      const d = row.dataset;
      if (d.logo) img.src = d.logo; else img.removeAttribute("src");
      q(".rv-logo b").textContent = (d.org ?? "?").trim()[0] ?? "?";
      q(".rv-org").textContent = d.org ?? "";
      q(".rv-period").textContent = d.period ?? "";
      q(".rv-role").textContent = d.role ?? "";
      q(".rv-desc").textContent = d.desc ?? "";
      if (!card.classList.contains("on")) { x = e.clientX + 24; y = e.clientY + 18; }
      place(e);
      card.classList.add("on");
    });
    document.addEventListener("pointermove", (e) => { if (active) place(e); }, { passive: true });
    window.addEventListener("scroll", () => { if (active) { active = null; card.classList.remove("on"); } }, { passive: true });
  }
</script>
