---
import { PORTFOLIO_DATA } from "../data/portfolio";
---

<section id="gui-github" class="gh-card">
  <div class="gh-head">
    <div>
      <p class="gh-total"><span id="gh-total">—</span> contributions</p>
      <p class="gh-sub">in the last 12 months · public activity</p>
    </div>
    <a href={PORTFOLIO_DATA.developer.github} target="_blank" rel="noopener noreferrer" class="gh-link">@{PORTFOLIO_DATA.developer.handle} ↗</a>
  </div>

  <div id="github-contribution-graph" data-user={PORTFOLIO_DATA.developer.handle} aria-live="polite" class="gh-scroll">
    <div class="gh-months" aria-hidden="true"></div>
    <div class="github-graph-grid" aria-label="Loading GitHub contribution graph"></div>
    <div class="gh-foot">
      <p class="gh-status">Loading contribution activity…</p>
      <span class="gh-legend" aria-hidden="true">Less <i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i> More</span>
    </div>
  </div>
</section>

<script>
  const graph = document.getElementById("github-contribution-graph");
  const grid = graph?.querySelector<HTMLElement>(".github-graph-grid");
  const months = graph?.querySelector<HTMLElement>(".gh-months");
  const status = graph?.querySelector<HTMLElement>(".gh-status");
  const total = document.getElementById("gh-total");
  const user = graph?.getAttribute("data-user");

  async function loadContributionGraph() {
    if (!graph || !grid || !status || !user) return;
    try {
      const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(user)}?y=last`, { cache: "no-store" });
      if (!response.ok) throw new Error("Contribution data unavailable");
      const payload = await response.json();
      let days: { date: string; count: number; level: number }[] = payload.contributions ?? [];
      if (!Array.isArray(days) || days.length === 0) throw new Error("No contribution data");

      // Start on a Sunday so each column is one calendar week.
      const firstSunday = days.findIndex((d) => new Date(d.date).getDay() === 0);
      days = days.slice(Math.max(0, firstSunday));

      grid.innerHTML = "";
      days.forEach((day, i) => {
        const cell = document.createElement("span");
        cell.className = "github-graph-cell";
        cell.dataset.l = String(Math.max(0, Math.min(day.level, 4)));
        cell.style.setProperty("--i", String(Math.floor(i / 7)));
        cell.title = `${new Date(day.date).toDateString()}: ${day.count} contribution${day.count === 1 ? "" : "s"}`;
        grid.appendChild(cell);
      });

      if (months) {
        months.innerHTML = "";
        const weeks = Math.ceil(days.length / 7);
        months.style.gridTemplateColumns = `repeat(${weeks}, var(--cell))`;
        let last = -1;
        for (let w = 0; w < weeks; w++) {
          const d = new Date(days[w * 7].date);
          const label = document.createElement("span");
          if (d.getMonth() !== last && d.getDate() <= 7) {
            label.textContent = d.toLocaleString(undefined, { month: "short" });
            last = d.getMonth();
          }
          months.appendChild(label);
        }
      }

      const sum = days.reduce((acc, d) => acc + d.count, 0);
      if (total) total.textContent = sum.toLocaleString();
      graph.setAttribute("aria-label", `GitHub contribution graph for ${user}: ${sum} contributions in the last year`);
      status.textContent = `${days.filter((d) => d.count > 0).length} active days`;
      graph.classList.add("loaded");
    } catch {
      grid.innerHTML = "";
      status.textContent = "Contribution data is unavailable right now — see the GitHub profile.";
    }
  }

  loadContributionGraph();
  window.setInterval(loadContributionGraph, 30 * 60 * 1000);
</script>

<style is:global>
  .gh-card {
    --cell: 11px;
    --gap: 3px;
    --gh-0: rgb(11 16 32 / 0.07);
    --gh-1: #c5d4ff;
    --gh-2: #8ba7ff;
    --gh-3: #5b7cff;
    --gh-4: #3d4fe0;
    border-radius: 18px;
    padding: 20px;
    background: var(--bg-card, #fff);
    border: 1px solid var(--border-color, rgb(11 16 32 / 0.08));
  }
  .os[data-mode="dark"] .gh-card {
    --gh-0: rgb(255 255 255 / 0.06);
    --gh-1: #24346e;
    --gh-2: #3a56b8;
    --gh-3: #5f84f5;
    --gh-4: #a3bcff;
  }
  .gh-card .gh-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .gh-card .gh-total { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.03em; color: var(--fg-bright, #0b1020); }
  .gh-card .gh-total span { color: var(--accent, #3d6bff); }
  .gh-card .gh-sub { font-size: 12px; color: var(--fg-dim, #6b7390); }
  .gh-card .gh-link { font-size: 12px; font-weight: 600; color: var(--accent, #3d6bff); }
  .gh-card .gh-link:hover { text-decoration: underline; }
  .gh-card .gh-scroll { overflow-x: auto; padding-bottom: 4px; }
  .gh-card .gh-months { display: grid; gap: var(--gap); margin-bottom: 6px; font-size: 10px; color: var(--fg-dim, #6b7390); min-width: max-content; }
  .gh-card .gh-months span { white-space: nowrap; overflow: visible; width: var(--cell); }
  .gh-card .github-graph-grid { display: grid; grid-template-rows: repeat(7, var(--cell)); grid-auto-flow: column; grid-auto-columns: var(--cell); gap: var(--gap); min-width: max-content; }
  .gh-card .github-graph-cell, .gh-card .gh-legend i { display: block; width: var(--cell); height: var(--cell); border-radius: 3px; background: var(--gh-0); }
  .gh-card .github-graph-cell[data-l="1"], .gh-card .gh-legend i[data-l="1"] { background: var(--gh-1); }
  .gh-card .github-graph-cell[data-l="2"], .gh-card .gh-legend i[data-l="2"] { background: var(--gh-2); }
  .gh-card .github-graph-cell[data-l="3"], .gh-card .gh-legend i[data-l="3"] { background: var(--gh-3); }
  .gh-card .github-graph-cell[data-l="4"], .gh-card .gh-legend i[data-l="4"] { background: var(--gh-4); box-shadow: 0 0 6px rgb(61 107 255 / 0.5); }
  .gh-card .github-graph-cell { transition: transform 0.15s; }
  .gh-card .github-graph-cell:hover { transform: scale(1.5); outline: 1px solid var(--accent, #3d6bff); }
  .gh-card .loaded .github-graph-cell { animation: cellIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--i) * 12ms); }
  @keyframes cellIn { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  .gh-card .gh-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; margin-top: 12px; font-size: 11px; color: var(--fg-dim, #6b7390); min-width: max-content; }
  .gh-card .gh-legend { display: inline-flex; align-items: center; gap: 4px; }
  @media (min-width: 1100px) { .gh-card { --cell: 15px; --gap: 4px; } }
  @media (max-width: 640px) { .gh-card { --cell: 8px; --gap: 2px; padding: 16px; } }
  @media (prefers-reduced-motion: reduce) { .gh-card .loaded .github-graph-cell { animation: none; } }
</style>
