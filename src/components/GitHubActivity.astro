---
import { PORTFOLIO_DATA } from "../data/portfolio";
---

<section id="gui-github" class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--border-color)] pb-3">
    <div>
      <h2 class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"><span class="text-[var(--accent)]">></span> GITHUB_ACTIVITY.LOG // CONTRIBUTIONS</h2>
      <p class="mt-1 text-[10px] text-[var(--fg-dim)]">PUBLIC ACTIVITY · LAST 12 MONTHS</p>
    </div>
    <a href={PORTFOLIO_DATA.developer.github} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[var(--accent)] hover:underline">@{PORTFOLIO_DATA.developer.handle} ↗</a>
  </div>

  <div id="github-contribution-graph" data-user={PORTFOLIO_DATA.developer.handle} aria-live="polite" class="overflow-x-auto">
    <div class="github-graph-grid min-w-[371px]" aria-label="Loading GitHub contribution graph"></div>
    <p class="mt-3 text-[10px] text-[var(--fg-dim)]">Loading public contribution activity…</p>
  </div>
</section>

<script>
  const graph = document.getElementById("github-contribution-graph");
  const grid = graph?.querySelector(".github-graph-grid");
  const status = graph?.querySelector("p");
  const user = graph?.getAttribute("data-user");

  function colorFor(level: number) {
    const colors = ["#1b2b20", "#075c32", "#0b8f46", "#16b85c", "#65e68c"];
    return colors[Math.max(0, Math.min(level, 4))];
  }

  async function loadContributionGraph() {
    if (!graph || !grid || !status || !user) return;
    try {
      const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(user)}?y=last`, { cache: "no-store" });
      if (!response.ok) throw new Error("Contribution data unavailable");
      const payload = await response.json();
      const contributions = payload.contributions?.slice(-371);
      if (!Array.isArray(contributions) || contributions.length === 0) throw new Error("No contribution data");

      grid.innerHTML = "";
      contributions.forEach((day: { date: string; count: number; level: number }) => {
        const cell = document.createElement("span");
        cell.className = "github-graph-cell";
        cell.style.backgroundColor = colorFor(day.level);
        cell.title = `${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`;
        grid.appendChild(cell);
      });
      graph.setAttribute("aria-label", `GitHub contribution graph for ${user}`);
      status.textContent = "Less activity  ▪ ▪ ▪ ▪ ▪  More activity";
    } catch {
      grid.innerHTML = "";
      status.textContent = "GitHub contribution data is currently unavailable. Visit the profile to view activity.";
    }
  }

  loadContributionGraph();
  window.setInterval(loadContributionGraph, 30 * 60 * 1000);
</script>

<style>
  .github-graph-grid {
    display: grid;
    grid-template-rows: repeat(7, 6px);
    grid-auto-flow: column;
    grid-auto-columns: 6px;
    gap: 1px;
  }
  .github-graph-cell { display: block; border: 1px solid rgba(0, 255, 102, 0.1); }
  @media (min-width: 640px) {
    .github-graph-grid { grid-template-rows: repeat(7, 11px); grid-auto-columns: 11px; gap: 3px; }
  }
</style>
