---
// Port of Vengeance UI "social-flip-button" (React + framer-motion) to plain Astro + CSS.
// Hovering the bar flips each tile from a letter to its icon, staggered; each tile shows a tooltip.
import { PORTFOLIO_DATA } from "../../data/portfolio";
const d = PORTFOLIO_DATA.developer;

const icons = {
  mail: '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zm1.8.3 7.2 5.6 7.2-5.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  github: '<path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2"/>',
  linkedin: '<path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5M3 9.75h4v11H3zm6.5 0h3.8v1.5h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.45h-4v-4.83c0-1.15-.02-2.64-1.6-2.64-1.62 0-1.86 1.26-1.86 2.56v4.91h-4z"/>',
  x: '<path fill="currentColor" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.36 5.77zm-1.08 16.18h1.7L7.4 4.73H5.58z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/>',
  web: '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3" fill="none" stroke="currentColor" stroke-width="1.8"/>',
} as const;

const items = [
  { letter: "H", icon: "mail", label: "Email", href: `mailto:${d.email}` },
  { letter: "E", icon: "github", label: "GitHub", href: d.github },
  { letter: "L", icon: "linkedin", label: "LinkedIn", href: d.linkedin },
  { letter: "L", icon: "x", label: "X", href: d.twitter },
  { letter: "O", icon: "instagram", label: "Instagram", href: d.instagram },
  { letter: "!", icon: "web", label: "loopfound.in", href: d.website },
] as const;
---

<div class="sflip glass">
  {items.map((it, i) => (
    <a
      href={it.href}
      class="sflip-node"
      style={`--i:${i}`}
      aria-label={it.label}
      {...(it.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      <span class="sflip-tip" aria-hidden="true">{it.label}</span>
      <span class="sflip-card">
        <span class="sflip-face sflip-front" aria-hidden="true">{it.letter}</span>
        <span class="sflip-face sflip-back"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={icons[it.icon]} /></span>
      </span>
    </a>
  ))}
</div>

<style>
  .sflip { position: relative; display: inline-flex; gap: 8px; padding: 12px; border-radius: 18px; border: 1px solid var(--hair); }
  /* Two light lines run along the top and bottom borders in opposite directions */
  .sflip::before, .sflip::after { content: ""; position: absolute; left: 0; width: 100%; height: 1px; pointer-events: none; background: linear-gradient(90deg, transparent, var(--sflip-line, rgb(0 0 0 / 0.45)), transparent); animation: sflipLine 2.5s linear infinite; }
  .sflip::before { top: -1px; }
  .sflip::after { bottom: -1px; animation-direction: reverse; }
  :global(.os[data-mode="dark"]) .sflip { --sflip-line: rgb(255 255 255 / 0.5); }
  .sflip { overflow: visible; clip-path: inset(-60px 0 -2px 0 round 18px); }
  @keyframes sflipLine { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

  .sflip-node { position: relative; width: 40px; height: 40px; perspective: 1000px; border-radius: 10px; }
  .sflip-card { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.34, 1.45, 0.5, 1); transition-delay: calc(var(--i) * 80ms); }
  .sflip:hover .sflip-card, .sflip:focus-within .sflip-card { transform: rotateY(180deg); }
  .sflip-face { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 10px; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .sflip-front { font: 700 17px "Geist", sans-serif; color: var(--ink); background: var(--glass-strong); border: 1px solid var(--hair); box-shadow: 0 1px 2px rgb(0 0 0 / 0.06); }
  .sflip-back { transform: rotateY(180deg); background: var(--ink); color: var(--desk); }

  .sflip-tip { position: absolute; left: 50%; bottom: 100%; z-index: 5; padding: 5px 10px; border-radius: 8px; white-space: nowrap; font: 600 11px "Geist", sans-serif; background: var(--ink); color: var(--desk); box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.4); pointer-events: none; opacity: 0; transform: translate(-50%, 10px) scale(0.8); transition: opacity 0.2s ease-out, transform 0.2s ease-out; }
  .sflip-tip::after { content: ""; position: absolute; left: 50%; bottom: -4px; width: 8px; height: 8px; background: inherit; transform: translateX(-50%) rotate(45deg); }
  .sflip-node:hover .sflip-tip, .sflip-node:focus-visible .sflip-tip { opacity: 1; transform: translate(-50%, -10px) scale(1); }
  .sflip-node:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .sflip::before, .sflip::after { animation: none; opacity: 0; }
    .sflip-card { transition-duration: 0.01s; transition-delay: 0s; }
  }
</style>
