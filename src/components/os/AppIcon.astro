---
// Hand-drawn app icons for goprOS: a coloured squircle with a simple line glyph.
interface Props {
  name: keyof typeof icons;
  size?: number;
  plain?: boolean;
}

const icons = {
  home: { bg: ["#5b8cff", "#3d6bff"], d: "M4 11.5 12 5l8 6.5M6.5 10v8.5h11V10M10 18.5v-5h4v5" },
  now: { bg: ["#20c997", "#12b886"], d: "M14.5 5.5a4 4 0 0 0-5 5L5 15l4 4 4.5-4.5a4 4 0 0 0 5-5l-2.5 2.5-2.5-.5-.5-2.5z" },
  work: { bg: ["#ffc53d", "#f59f00"], d: "M4 8.5A1.5 1.5 0 0 1 5.5 7H10l2 2h6.5A1.5 1.5 0 0 1 20 10.5v7a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z" },
  experience: { bg: ["#8b6cff", "#7c5cf6"], d: "M4.5 9h15v9.5h-15zM9 9V6.5h6V9M4.5 13.5h15" },
  orgs: { bg: ["#4dabf7", "#228be6"], d: "M4 19h16M5.5 19V10M9.5 19V10M14.5 19V10M18.5 19V10M3.5 10 12 5l8.5 5z" },
  stage: { bg: ["#ff6b9a", "#f0487a"], d: "M12 4.5a2.5 2.5 0 0 1 2.5 2.5v4a2.5 2.5 0 0 1-5 0V7A2.5 2.5 0 0 1 12 4.5zM7 11a5 5 0 0 0 10 0M12 16v3.5M9 19.5h6" },
  stack: { bg: ["#ff8c42", "#e8590c"], d: "M12 4.5 20 8.5l-8 4-8-4zM4 12.5l8 4 8-4M4 16.5l8 4 8-4" },
  about: { bg: ["#63e6be", "#0ca678"], d: "M12 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5.5 19.5a6.5 6.5 0 0 1 13 0" },
  mail: { bg: ["#74c0fc", "#339af0"], d: "M4.5 7h15v10.5h-15zM4.5 7.5 12 13l7.5-5.5" },
  terminal: { bg: ["#343a40", "#0b1020"], d: "M5 7.5 9.5 12 5 16.5M12 17h7" },
  resume: { bg: ["#e9ecef", "#ced4da"], d: "M7 4.5h7l4 4v11H7zM14 4.5v4h4M9.5 12.5h6M9.5 15.5h6", ink: "#343a40" },
  github: { bg: ["#495057", "#212529"], d: "M9 19c-4 1.2-4-2-5.5-2.5M14.5 21v-3.3a2.8 2.8 0 0 0-.8-2.2c2.6-.3 5.3-1.3 5.3-5.8a4.5 4.5 0 0 0-1.2-3.1 4.2 4.2 0 0 0-.1-3.1s-1-.3-3.2 1.2a11 11 0 0 0-5.8 0C6.5 3.2 5.5 3.5 5.5 3.5a4.2 4.2 0 0 0-.1 3.1A4.5 4.5 0 0 0 4.2 9.7c0 4.5 2.7 5.5 5.3 5.8a2.8 2.8 0 0 0-.8 2.2V21" },
  badge: { bg: ["#ffd43b", "#fab005"], d: "M12 14.5a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM9 13.5 8 20l4-2 4 2-1-6.5", ink: "#5c3d00" },
  music: { bg: ["#69db7c", "#2f9e44"], d: "M9.5 17.5V6.5l9-2v11M9.5 17.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM18.5 15.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" },
  agents: { bg: ["#9775fa", "#5f3dc4"], d: "M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM5.5 5.5l4.7 4.7M18.5 5.5l-4.7 4.7M5.5 18.5l4.7-4.7M18.5 18.5l-4.7-4.7" },
  stats: { bg: ["#4c6ef5", "#364fc7"], d: "M5 19.5h14M7.5 16v-4M12 16V8M16.5 16v-6" },
  pin: { bg: ["#ffe066", "#fcc419"], d: "M12 4.5v5M8.5 9.5h7l-1 4h-5zM12 13.5v6", ink: "#5c3d00" },
};

const { name, size = 40, plain = false } = Astro.props;
const icon = icons[name];
const ink = (icon as { ink?: string }).ink ?? "#fff";
const gid = `ai-${name}`;
---

{plain ? (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.d} /></svg>
) : (
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="app-icon">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={icon.bg[0]} />
        <stop offset="1" stop-color={icon.bg[1]} />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="38" height="38" rx="11" fill={`url(#${gid})`} />
    <rect x="1.5" y="1.5" width="37" height="37" rx="10.5" fill="none" stroke="rgb(255 255 255 / 0.35)" />
    <g transform="translate(8 8)" fill="none" stroke={ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icon.d} /></g>
  </svg>
)}
