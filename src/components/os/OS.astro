          <div class="mt-6 flex flex-wrap gap-1.5" role="tablist" aria-label="Choose a principle">
            {principles.map((p, i) => (
              <button type="button" role="tab" class:list={["pr-dot os-mono", i === 0 && "on"]} data-i={i} aria-selected={i === 0 ? "true" : "false"} title={p.title}>{String(i + 1).padStart(2, "0")}</button>
            ))}
