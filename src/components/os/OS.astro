---
import "../../styles/os.css";
import { PORTFOLIO_DATA, eventDateValue } from "../../data/portfolio";
import Win from "./Win.astro";
import AppIcon from "./AppIcon.astro";
import Boot from "./Boot.astro";
import AgentGraph from "../AgentGraph.astro";
import RoleList from "../RoleList.astro";
import GitHubActivity from "../GitHubActivity.astro";

const {
  developer, profile, operatingVector, nowBuilding, learning, wins, labs, orgs, gssoc,
  skills, collabs, experience, internships, ambassadorExperience, events, principles,
} = PORTFOLIO_DATA;

const featured = collabs.filter((c) => c.featured);
const more = collabs.filter((c) => !c.featured);
const leadership = experience.slice(0, 3);
const communities = experience.slice(3);
const byNewest = [...events].sort((a, b) => eventDateValue(b.date) - eventDateValue(a.date));
const talks = byNewest.filter((e) => /speaker/i.test(e.role));
const otherEvents = byNewest.filter((e) => !/speaker/i.test(e.role));

const apps = [
  { href: "#desktop", icon: "home", label: "Home" },
  { href: "#now", icon: "now", label: "Now building" },
  { href: "#work", icon: "work", label: "Projects" },
  { href: "#experience", icon: "experience", label: "Experience" },
  { href: "#orgs", icon: "orgs", label: "Organizations" },
  { href: "#stage", icon: "stage", label: "Talks & events" },
  { href: "#stack", icon: "stack", label: "Stack" },
  { href: "#about", icon: "about", label: "About" },
  { href: "#contact", icon: "mail", label: "Mail me" },
];

const coverColors: Record<string, [string, string]> = {
  livora: ["#2f9e44", "#f08c00"],
  orvio: ["#f0487a", "#7c5cf6"],
  unbd: ["#e8590c", "#c92a2a"],
};

const kindPill = (type: string) => {
  if (/hackathon/i.test(type)) return "pill-amber";
  if (/client|company/i.test(type)) return "pill-rose";
  if (/desktop|app/i.test(type)) return "pill-violet";
  return "pill-blue";
};

const notchMessages = [
  developer.status.trim().toLowerCase().replace(/^./, (c) => c.toUpperCase()),
  `Building ${nowBuilding[0].name}`,
  "Islet is out — a notch for Windows",
  `${developer.headlineStats[0].value} users served`,
  "AI Eng & Tech Lead @ Redrox",
];
---

<div class="os" data-site>
  <Boot />
  <div class="wallpaper" aria-hidden="true"><span></span><span></span><span></span></div>

  <!-- NOTCH: status + quick launcher -->
  <div class="notch-wrap">
    <div class="notch" id="notch" role="button" tabindex="0" aria-expanded="false" aria-label="Status and quick menu">
      <div class="notch-bar">
        <span class="live" aria-hidden="true"></span>
        <span class="notch-msg" aria-live="polite">
          {notchMessages.map((m, i) => <span class:list={[i === 0 && "on"]}>{m}</span>)}
        </span>
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span id="notch-clock" class="os-mono text-[11px] text-white/70">--:--</span>
      </div>
      <div class="notch-panel">
        <div class="flex items-center justify-between pb-2 text-[11px] text-white/60">
          <span>{developer.alias}</span>
          <button type="button" id="mode-toggle" class="rounded-full bg-white/10 px-2.5 py-1 hover:bg-white/20" aria-label="Toggle light and dark mode">◐ Theme</button>
        </div>
        <div class="grid grid-cols-5 gap-1">
          {apps.slice(1).map((a) => <a href={a.href} class="notch-app"><AppIcon name={a.icon as any} size={34} />{a.label.split(" ")[0]}</a>)}
          <a href="/terminal" class="notch-app"><AppIcon name="terminal" size={34} />Terminal</a>
        </div>
      </div>
    </div>
  </div>

  <!-- DOCK: main navigation -->
  <nav class="dock glass" aria-label="Sections">
    {apps.map((a) => <a href={a.href} data-label={a.label} class="dock-link"><AppIcon name={a.icon as any} size={44} /><span class="sr-only">{a.label}</span></a>)}
    <span class="sep" aria-hidden="true"></span>
    <a href={developer.github} target="_blank" rel="noopener noreferrer" data-label="GitHub"><AppIcon name="github" size={44} /><span class="sr-only">GitHub</span></a>
    <a href="/terminal" data-label="Terminal"><AppIcon name="terminal" size={44} /><span class="sr-only">Terminal</span></a>
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" data-label="Resume"><AppIcon name="resume" size={44} /><span class="sr-only">Resume</span></a>
  </nav>

  <main>
    <!-- DESKTOP / HERO -->
    <section id="desktop" class="desktop os-wrap grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <div class="flex items-center gap-4" data-boot style="--d:.05s">
          <img src="/images/gopinath.jpg" alt="Gopinath R" class="avatar" width="64" height="64" />
          <p class="who">
            <b>Gopinath R</b>
            <span><span class="live"></span>Open to internships and collaborations</span>
          </p>
        </div>
        <h1 class="hello mt-8" data-boot style="--d:.15s">I build AI agents for the problems nobody wants to own.</h1>
        <p class="lede mt-6" data-boot style="--d:.3s">
          Flood response, grievance desks, student communities. Full-stack developer from {developer.location}; I co-founded LoopFound, lead tech at Redrox and write frontend at Anaxly. Most of what I ship starts at a hackathon and keeps going in open source.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3" data-boot style="--d:.42s">
          <a href="#work" class="ob ob-primary">See projects</a>
          <a href="#contact" class="ob">Email me</a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="ob">Resume (PDF)</a>
        </div>
        <p class="elsewhere mt-6" data-boot style="--d:.5s">
          Also on <a href={developer.github} target="_blank" rel="noopener noreferrer">GitHub</a>, <a href={developer.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>, <a href={developer.twitter} target="_blank" rel="noopener noreferrer">X</a>, and I post <a href={developer.instagram} target="_blank" rel="noopener noreferrer">photography</a> too.
        </p>
      </div>

      <!-- Draggable widgets -->
      <div class="widgets grid gap-4 lg:col-span-6 lg:block" id="widgets">
        <div class="widget glass lg:left-0 lg:top-[2%] lg:w-[270px]" data-widget data-boot style="--d:.35s">
          <div class="widget-head"><AppIcon name="stats" size={18} />So far</div>
          <ul class="facts">
            {developer.headlineStats.map((s) => (
              <li><b data-count={s.value} class="tabular-nums">{s.value}</b> {s.label.toLowerCase()}</li>
            ))}
          </ul>
        </div>

        <div class="widget glass lg:right-0 lg:top-[24%] lg:w-[300px]" data-widget data-boot style="--d:.45s">
          <div class="widget-head"><AppIcon name="agents" size={18} />Agents I've built</div>
          <div class="-m-2"><AgentGraph /></div>
        </div>

        <div class="widget glass lg:left-[4%] lg:top-[48%] lg:w-[285px]" data-widget data-boot style="--d:.55s">
          <div class="widget-head"><AppIcon name="now" size={18} />Working on this week</div>
          <ul class="space-y-2 text-sm" id="widget-now">
            {nowBuilding.slice(0, 5).map((p) => (
              <li class="flex items-center justify-between gap-3">
                <span class="font-medium text-[var(--ink)]">{p.name}</span>
                <span class="text-[12px] text-[var(--muted)]">{p.context}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="widget note lg:right-[3%] lg:top-[-2%] lg:w-[215px] lg:rotate-[2deg]" data-widget data-boot style="--d:.65s">
          <p class="text-[15px] font-medium leading-snug">Building something? I take on products, freelance work and hackathon teams.</p>
          <a href="#contact" class="mt-3 inline-block text-sm font-bold underline underline-offset-4">Write to me</a>
        </div>
      </div>
    </section>

    <!-- SIGNAL STRIP -->
    <div class="os-wrap pb-6">
      <div class="glass flex flex-wrap items-center gap-2 rounded-2xl p-3" data-reveal>
        <span class="os-mono px-2 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Recent ▸</span>
        {wins.map((w) => <span class="pill">✓ {w}</span>)}
      </div>
    </div>

    <!-- NOW BUILDING -->
    <Win id="now" title="now.log — in active development" icon="now" sub="Stuff that isn't finished yet. Some of it will break.">
      <Fragment slot="heading">Currently <span class="os-serif">building</span></Fragment>
      <p class="os-mono mb-3 flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]"><span class="live !h-1.5 !w-1.5"></span>Pushed recently · live from GitHub</p>
      <div id="now-live" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite">
        {[0, 1, 2, 3].map(() => <div class="tile skeleton h-[168px]"></div>)}
      </div>

      <p class="os-mono mt-8 mb-3 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Also on the bench · next up on GitHub</p>
      <div id="now-bench" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite">
        {[0, 1, 2, 3].map(() => <div class="tile skeleton h-[104px]"></div>)}
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-2xl border border-[var(--hair)] p-4 text-sm" data-reveal>
        <span class="os-mono text-[11px] uppercase tracking-[0.12em] text-[var(--blue)]">Learning</span>
        {learning.map((l) => <span><b class="text-[var(--ink)]">{l.name}</b> <span class="text-[var(--muted)]">— {l.detail}</span></span>)}
      </div>
    </Win>

    <!-- PROJECTS -->
    <Win id="work" title="Projects — Explorer" icon="work" sub={`${collabs.length} shipped builds, ${labs.length} labs experiments. Click any card for the full story.`}>
      <Fragment slot="heading">Featured <span class="os-serif">work</span></Fragment>
      <div class="grid gap-4 md:grid-cols-2">
        {featured.map((item) => {
          const [c1, c2] = coverColors[item.id] ?? ["#3d6bff", "#7c5cf6"];
          return (
            <a href={`/projects/${item.id}`} class="tile group block p-3" data-spot data-reveal data-repo={item.repo?.replace("https://github.com/", "").toLowerCase()}>
              <div class="cover">
                {item.image ? (
                  <img src={item.image} alt={`Screenshot of ${item.title}`} loading="lazy" data-parallax />
                ) : (
                  <div class="cover-gen h-full" style={`--c1:${c1};--c2:${c2}`}>
                    <strong>{item.title}</strong><small>{item.partnerType}</small>
                  </div>
                )}
              </div>
              <div class="p-3 pt-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`pill ${kindPill(item.partnerType)}`}>{item.partnerType}</span>
                  {item.status !== "COMPLETED" && <span class="pill pill-mint">{item.status === "ONGOING" ? "in progress" : "live"}</span>}
                  <span class="live-meta os-mono ml-auto text-[11px] text-[var(--muted)]">{item.period}</span>
                </div>
                <h3 class="mt-3 flex items-center justify-between text-2xl font-bold tracking-tight text-[var(--ink)]">
                  {item.title}<span class="text-lg text-[var(--muted)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--blue)]">→</span>
                </h3>
                <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-[var(--ink-2)]">{item.description}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">{item.techStack.slice(0, 4).map((t) => <span class="pill">{t}</span>)}</div>
              </div>
            </a>
          );
        })}
      </div>

      <h3 class="os-mono mt-12 mb-4 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">More shipped work</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {more.map((item) => (
          <a href={`/projects/${item.id}`} class="tile group flex gap-3 p-3" data-spot data-reveal>
            <div class="h-16 w-24 shrink-0 overflow-hidden rounded-lg bg-[var(--ink)]">
              {item.image ? <img src={item.image} alt="" loading="lazy" class="h-full w-full object-cover object-top" /> : <div class="cover-gen h-full !rounded-none"><small>{item.title}</small></div>}
            </div>
            <div class="min-w-0">
              <p class="truncate font-semibold text-[var(--ink)] group-hover:text-[var(--blue)]">{item.title}</p>
              <p class="truncate text-xs text-[var(--muted)]">{item.partnerType} · {item.period}</p>
              <p class="mt-1 truncate text-xs text-[var(--ink-2)]">{item.techStack.slice(0, 3).join(" · ")}</p>
            </div>
          </a>
        ))}
      </div>

      <h3 class="os-mono mt-12 mb-4 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Labs — side quests</h3>
      <div class="grid gap-3 md:grid-cols-3">
        {labs.map((l) => (
          <a href={l.link} target="_blank" rel="noopener noreferrer" class="tile block p-5" data-spot data-reveal>
            <div class="flex items-center justify-between"><span class="pill pill-violet">{l.stack}</span><span class="text-[var(--muted)]">↗</span></div>
            <h4 class="mt-4 text-lg font-bold text-[var(--ink)]">{l.name}</h4>
            <p class="mt-1 text-sm leading-relaxed text-[var(--ink-2)]">{l.detail}</p>
          </a>
        ))}
      </div>
    </Win>

    <!-- EXPERIENCE -->
    <Win id="experience" title="experience.exe" icon="experience" sub={`${internships.length} industry roles — pick one.`}>
      <Fragment slot="heading">Where I've <span class="os-serif">built</span></Fragment>
      <div class="grid gap-4 lg:grid-cols-12">
        <div class="flex gap-1 overflow-x-auto lg:col-span-4 lg:flex-col" role="tablist" aria-label="Experience">
          {internships.map((item, i) => (
            <button type="button" role="tab" id={`xp-tab-${i}`} aria-controls={`xp-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} class="xp-tab shrink-0 px-4 py-3 lg:w-full">
              <span class="flex items-center gap-2 font-semibold">{item.status === "ACTIVE" && <span class="live !h-1.5 !w-1.5"></span>}{item.organization}</span>
              <span class="os-mono mt-0.5 block text-[11px]">{item.period.split(" · ")[0]}</span>
            </button>
          ))}
        </div>
        <div class="tile p-6 sm:p-8 lg:col-span-8" data-spot>
          {internships.map((item, i) => (
            <div role="tabpanel" id={`xp-panel-${i}`} aria-labelledby={`xp-tab-${i}`} class="xp-panel" hidden={i !== 0}>
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={["pill", item.status === "ACTIVE" ? "pill-mint" : ""]}>{item.status === "ACTIVE" ? "current" : "completed"}</span>
                <span class="os-mono text-xs text-[var(--muted)]">{item.period}</span>
              </div>
              <h3 class="mt-5 text-3xl font-bold tracking-tight text-[var(--ink)]">{item.role}</h3>
              <p class="os-serif mt-1 text-2xl text-[var(--blue)]">@ {item.organization}</p>
              <p class="mt-5 max-w-2xl text-base leading-relaxed text-[var(--ink-2)]">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </Win>

    <!-- ORGANIZATIONS & LEADERSHIP -->
    <Win id="orgs" title="Organizations" icon="orgs" sub="Places I started, run, or hang around in.">
      <Fragment slot="heading">Building <span class="os-serif">people</span>, too</Fragment>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {orgs.map((o) => (
          <a href={o.link} target="_blank" rel="noopener noreferrer" class="tile group flex flex-col gap-4 p-5" data-spot data-reveal>
            <div class="flex items-start justify-between gap-3">
              {o.logo
                ? <img src={o.logo} alt="" class="h-12 w-12 rounded-2xl object-cover shadow-sm" loading="lazy" />
                : <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--ink)] text-sm font-bold text-[var(--desk)]">{o.name.replace(/[^A-Za-z ]/g, "").split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase()}</span>}
              <span class={`pill shrink-0 !text-[10px] ${o.badge === "Founder" ? "pill-blue" : o.badge === "Rare" ? "pill-amber" : o.badge === "Lead" ? "pill-violet" : ""}`}>{o.badge}</span>
            </div>
            <div>
              <h3 class="text-lg font-bold leading-tight tracking-tight text-[var(--ink)] group-hover:text-[var(--blue)]">{o.name}</h3>
              <p class="mt-1 text-sm font-medium text-[var(--ink-2)]">{o.role}</p>
              <p class="os-mono mt-2 text-[11px] text-[var(--muted)]">{o.note}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {leadership.map((item) => (
          <article class="tile p-6" data-spot data-reveal>
            <span class="os-mono text-[11px] uppercase tracking-[0.1em] text-[var(--blue)]">{item.organization}</span>
            <h3 class="mt-3 text-xl font-bold text-[var(--ink)]">{item.role}</h3>
            <p class="os-mono mt-1 text-[11px] text-[var(--muted)]">{item.period}</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-2)]">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="tile p-6" data-reveal><h3 class="os-mono mb-4 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Communities &amp; clubs</h3><RoleList items={communities} /></div>
        <div class="tile p-6" data-reveal><h3 class="os-mono mb-4 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Ambassador programs</h3><RoleList items={ambassadorExperience} /></div>
      </div>
    </Win>

    <!-- GSSOC -->
    <Win id="gssoc" title="Achievements" icon="badge">
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4" data-reveal>
          <span class="pill pill-amber">★ Rare badge</span>
          <h2 class="win-h mt-4 !text-4xl">{gssoc.title}</h2>
          <p class="mt-2 font-semibold text-[var(--ink)]">{gssoc.role}</p>
          <p class="mt-2 text-sm text-[var(--muted)]">{gssoc.note}</p>
          <p class="os-mono mt-4 text-xs text-[var(--blue)]">{gssoc.badges.length} badges earned</p>
        </div>
        <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:col-span-8 lg:grid-cols-7">
          {gssoc.badges.map((b) => (
            <figure class="badge grid justify-items-center gap-2 text-center" data-reveal>
              <img src={b.image} alt="" class="badge-img" loading="lazy" width="92" height="92" />
              <figcaption class:list={["text-[11px]", b.rare ? "font-bold text-[var(--ink)]" : "text-[var(--muted)]"]}>{b.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </Win>

    <!-- STAGE -->
    <Win id="stage" title="Talks & events" icon="stage" sub={`${talks.length} talks given, ${events.length} events in total.`}>
      <Fragment slot="heading">On <span class="os-serif">stage</span></Fragment>
      <div class="overflow-hidden rounded-2xl border border-[var(--hair)]">
        {talks.map((e) => (
          <div class="trow grid gap-1 p-5 sm:grid-cols-12 sm:items-baseline" data-reveal>
            <span class="os-mono text-xs text-[var(--muted)] sm:col-span-3">{e.date}</span>
            <div class="sm:col-span-9">
              <h3 class="text-lg font-bold text-[var(--ink)]">{e.name}</h3>
              <p class="mt-1 text-sm text-[var(--ink-2)]">{e.contribution}</p>
            </div>
          </div>
        ))}
      </div>
      <details class="tile mt-4 p-5" data-reveal>
        <summary class="flex items-center justify-between font-semibold text-[var(--ink)]"><span>{otherEvents.length} more events organized &amp; competed in</span><span class="chev text-xl">›</span></summary>
        <ul class="mt-4">
          {otherEvents.map((e) => (
            <li class="trow grid gap-1 py-4 sm:grid-cols-12">
              <span class="os-mono text-xs text-[var(--muted)] sm:col-span-3">{e.date}</span>
              <div class="sm:col-span-9"><p class="font-semibold text-[var(--ink)]">{e.name} <span class="os-mono text-xs font-normal text-[var(--blue)]">· {e.role}</span></p><p class="mt-1 text-sm text-[var(--ink-2)]">{e.contribution}</p></div>
            </li>
          ))}
        </ul>
      </details>
    </Win>

    <!-- STACK -->
    <Win id="stack" title="Toolbox" icon="stack" sub="The bold ones are what I open first.">
      <Fragment slot="heading">The <span class="os-serif">stack</span></Fragment>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {skills.map((cat, i) => (
          <div class="tile p-5" data-spot data-reveal>
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-[var(--ink)]">{cat.category}</h3>
              <span class="os-mono text-[10px] text-[var(--muted)]">0{i + 1} · {cat.skills.length} tools</span>
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {cat.skills.map((s) => <span class:list={["pill", s.tag === "CORE" && "pill-blue font-semibold"]}>{s.name}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-4 grid gap-4 rounded-2xl border border-[var(--hair)] p-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {operatingVector.map((v) => <div><p class="font-semibold text-[var(--ink)]">{v.area}</p><p class="mt-1 text-sm text-[var(--muted)]">{v.detail}</p></div>)}
      </div>
    </Win>

    <!-- ABOUT -->
    <Win id="about" title="about.txt" icon="about">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="flex flex-col lg:col-span-6" data-reveal>
          <p class="os-mono text-sm text-[var(--blue)]">const gopinath = () =&gt; ship();</p>
          <h2 class="win-h mt-3">How I <span class="os-serif">think</span></h2>
          <p class="mt-5 text-[17px] leading-relaxed text-[var(--ink)]">{developer.bio}</p>
          {developer.quote && <blockquote class="os-serif mt-5 border-l-2 border-[var(--blue)] pl-4 text-xl text-[var(--blue)]">{developer.quote}</blockquote>}
          <div class="mt-auto flex flex-wrap gap-2 pt-6 text-xs">
            <span class="pill">📍 {developer.location}</span>
