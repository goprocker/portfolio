<script>
  // Live GitHub data (now building, bench, hero widget, project badges, stats) and the mail form.
  import { PORTFOLIO_DATA } from "../../data/portfolio";
  import { loadGitHub, timeAgo, type GitHubSnapshot, type Repo } from "../../utils/github";

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);

  // A repo without a GitHub "About" borrows the first sentence of the matching project blurb.
  const blurbs = new Map(
    PORTFOLIO_DATA.collabs
      .filter((c) => c.repo)
      .map((c) => [c.repo!.split("/").pop()!.toLowerCase(), c.description.split(/(?<=\.)\s/)[0]]),
  );
  const about = (r: Repo) => r.description || blurbs.get(r.name.toLowerCase()) || "Work in progress.";

  function nowCard(r: Repo) {
    const days = Math.floor((Date.now() - Date.parse(r.pushedAt)) / 86_400_000);
    const fresh = days <= 3;
    return `<a href="${r.url}" target="_blank" rel="noopener noreferrer" class="tile now-card group flex flex-col p-5" data-spot>
      <div class="flex items-center justify-between gap-2">
        <span class="pill ${fresh ? "pill-mint" : "pill-blue"}">${fresh ? '<span class="live !h-1.5 !w-1.5"></span>' : ""}pushed ${timeAgo(r.pushedAt)}</span>
        <span class="text-[var(--muted)] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
      </div>
      <h3 class="mt-5 text-xl font-bold tracking-tight text-[var(--ink)]">${esc(r.name)}</h3>
      <p class="mt-1 line-clamp-2 text-sm text-[var(--ink-2)]">${esc(about(r))}</p>
      <div class="mt-auto pt-4">
        <div class="flex items-center justify-between text-[11px] text-[var(--muted)]"><span class="os-mono">${esc(r.language)}</span><span class="os-mono">★ ${r.stars}</span></div>
        <div class="heat mt-2"><i style="width:${Math.max(8, 100 - days * 6)}%"></i></div>
      </div>
    </a>`;
  }

  function benchCard(r: Repo) {
    return `<a href="${r.url}" target="_blank" rel="noopener noreferrer" class="tile now-card group block !min-h-0 p-4" data-spot>
      <div class="flex items-center justify-between gap-2"><h3 class="truncate font-bold tracking-tight text-[var(--ink)]">${esc(r.name)}</h3><span class="text-[var(--muted)] group-hover:text-[var(--blue)]">↗</span></div>
      <p class="mt-1 truncate text-sm text-[var(--ink-2)]">${esc(about(r))}</p>
      <p class="os-mono mt-2 flex justify-between text-[11px] text-[var(--muted)]"><span>${esc(r.language)}</span><span>pushed ${timeAgo(r.pushedAt)}</span></p>
    </a>`;
  }

  function repoCard(r: Repo) {
    return `<a href="${r.url}" target="_blank" rel="noopener noreferrer" class="tile group flex flex-col p-4" data-spot>
      <div class="flex items-center justify-between gap-2">
        <span class="truncate text-sm font-bold text-[var(--ink)] group-hover:text-[var(--blue)]">${esc(r.name)}</span>
        <span class="shrink-0 text-[11px] text-[var(--muted)]">★ ${r.stars}</span>
      </div>
      <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-[var(--ink-2)]">${esc(about(r))}</p>
      <div class="mt-auto flex justify-between pt-3 text-[11px] text-[var(--muted)]">
        <span class="font-semibold text-[var(--violet)]">${esc(r.language || "—")}</span><span>${timeAgo(r.pushedAt)} ↗</span>
      </div>
    </a>`;
  }

  function render(gh: GitHubSnapshot) {
    const active = gh.repos.filter((r) => r.name.toLowerCase() !== "portfolio");
    const set = (id: string, html: string) => { const el = document.getElementById(id); if (el) el.innerHTML = html; };
    const text = (id: string, value: string | number) => { const el = document.getElementById(id); if (el) el.textContent = String(value); };

    if (active.length) {
      set("now-live", active.slice(0, 4).map(nowCard).join(""));
      set("now-bench", active.slice(4, 8).map(benchCard).join(""));
      set("widget-now", active.slice(0, 5).map((r) =>
        `<li class="flex items-center justify-between gap-3"><a href="${r.url}" target="_blank" rel="noopener noreferrer" class="truncate font-medium text-[var(--ink)] hover:text-[var(--blue)]">${esc(r.name)}</a><span class="os-mono shrink-0 text-[11px] text-[var(--muted)]">${timeAgo(r.pushedAt)}</span></li>`).join(""));
      const notchBuilding = document.querySelectorAll<HTMLElement>(".notch-msg span")[1];
      if (notchBuilding) notchBuilding.textContent = `Building ${active[0].name}`;
    }

    document.querySelectorAll<HTMLElement>("[data-repo]").forEach((card) => {
      const repo = gh.byFullName[card.dataset.repo ?? ""];
      const meta = card.querySelector<HTMLElement>(".live-meta");
      if (!repo || !meta) return;
      meta.textContent = `${repo.stars ? `★ ${repo.stars} · ` : ""}pushed ${timeAgo(repo.pushedAt)}`;
      meta.classList.add("text-[var(--blue)]");
    });

    text("gui-gh-stars", gh.stars);
    text("gui-gh-forks", gh.forks);
    text("gui-gh-repos", gh.publicRepos);
    text("gui-gh-followers", gh.followers);
    set("gui-gh-lang-list", gh.languages.map((l) => `<span class="pill pill-blue">${esc(l.name)} <span class="text-[var(--muted)]">${l.share}%</span></span>`).join(""));
    set("gui-gh-repos-list", gh.repos.slice(0, 6).map(repoCard).join(""));
    document.getElementById("gui-gh-loading")?.classList.add("hidden");
    document.getElementById("gui-gh-content")?.classList.remove("hidden");
  }

  async function initLive() {
    const gh = await loadGitHub();
    if (gh) return render(gh);
    const loading = document.getElementById("gui-gh-loading");
    if (loading) loading.textContent = "GitHub is rate-limiting right now — try again in a few minutes.";
    ["now-live", "now-bench"].forEach((id) => document.getElementById(id)?.replaceChildren());
  }

  // Mail form: posts to FormSubmit, shows inline status.
  function initMail() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");
    const button = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;
    const label = document.getElementById("btn-text");
    if (!form) return;

    const say = (msg: string, tone: "info" | "ok" | "err") => {
      if (!status) return;
      status.textContent = msg;
      status.className = `text-xs font-bold ${tone === "ok" ? "text-[var(--mint)]" : tone === "err" ? "text-[var(--rose)]" : "text-[var(--muted)]"}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (!data.name?.trim() || !data.email?.trim() || !data.message?.trim()) return;
      if (button) button.disabled = true;
      if (label) label.textContent = "Sending…";
      say("Sending your message…", "info");
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${form.dataset.recipientEmail}`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ ...data, _subject: `Portfolio message from ${data.name}`, _captcha: "false" }),
        });
        if (!res.ok) throw new Error(String(res.status));
        say("✓ Sent — I'll get back to you soon.", "ok");
        form.reset();
      } catch {
        say("Couldn't send right now. Email me directly instead.", "err");
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = "Send message →";
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initLive();
    initMail();
  });
</script>

<script>
  // Experience tabs
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[role='tab'][id^='xp-tab-']"));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = tabs[(i + (e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });
</script>

<script>
  // goprOS: notch, theme, draggable widgets, active dock icon.
  document.addEventListener("DOMContentLoaded", () => {
    const os = document.querySelector<HTMLElement>(".os");
    if (!os) return;

    // Theme: remember choice, default to system preference.
    let saved: string | null = null;
    try { saved = localStorage.getItem("goopros_mode"); } catch {}
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    os.dataset.mode = saved ?? (prefersDark ? "dark" : "light");
    document.getElementById("mode-toggle")?.addEventListener("click", (e) => {
      e.stopPropagation();
      os.dataset.mode = os.dataset.mode === "dark" ? "light" : "dark";
      try { localStorage.setItem("goopros_mode", os.dataset.mode); } catch {}
    });

    // Notch: clock, rotating status, expand on hover/tap.
    const notch = document.getElementById("notch");
    const clock = document.getElementById("notch-clock");
    const tickClock = () => {
      if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    };
    tickClock();
    setInterval(tickClock, 15000);

    const msgs = Array.from(document.querySelectorAll<HTMLElement>(".notch-msg span"));
    let current = 0;
    setInterval(() => {
      if (notch?.classList.contains("open") || msgs.length < 2) return;
      const prev = msgs[current];
      current = (current + 1) % msgs.length;
      prev.classList.remove("on");
      prev.classList.add("off");
      msgs[current].classList.remove("off");
      msgs[current].classList.add("on");
      setTimeout(() => prev.classList.remove("off"), 600);
    }, 3200);

    const setOpen = (open: boolean) => {
      notch?.classList.toggle("open", open);
      notch?.setAttribute("aria-expanded", String(open));
    };
    if (notch) {
      const canHover = window.matchMedia("(hover: hover)").matches;
      if (canHover) {
        notch.addEventListener("mouseenter", () => setOpen(true));
        notch.parentElement?.addEventListener("mouseleave", () => setOpen(false));
      }
      notch.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a, button")) return;
        setOpen(!notch.classList.contains("open"));
      });
      notch.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); setOpen(!notch.classList.contains("open")); }
        if (e.key === "Escape") setOpen(false);
      });
      notch.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("click", (e) => { if (!notch.contains(e.target as Node)) setOpen(false); });
    }

    // Draggable widgets (desktop layout only).
    const desktop = window.matchMedia("(min-width: 1024px)");
    let z = 10;
    document.querySelectorAll<HTMLElement>("[data-widget]").forEach((widget) => {
      const handle = widget.querySelector<HTMLElement>(".widget-head") ?? widget;
      if (!handle) return;
      let startX = 0, startY = 0, baseX = 0, baseY = 0, dragging = false;
      handle.addEventListener("pointerdown", (e) => {
        if (!desktop.matches) return;
        dragging = true;
        widget.classList.add("dragging");
        widget.style.zIndex = String(++z);
        startX = e.clientX; startY = e.clientY;
        baseX = parseFloat(widget.dataset.x ?? "0");
        baseY = parseFloat(widget.dataset.y ?? "0");
        handle.setPointerCapture(e.pointerId);
      });
      handle.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const x = baseX + e.clientX - startX;
        const y = baseY + e.clientY - startY;
        widget.dataset.x = String(x);
        widget.dataset.y = String(y);
        widget.style.translate = `${x}px ${y}px`;
      });
      const end = () => { dragging = false; widget.classList.remove("dragging"); };
      handle.addEventListener("pointerup", end);
      handle.addEventListener("pointercancel", end);
    });

    // Dock: mark the app for the section in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".dock a.dock-link"));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) => l.classList.toggle("active", l.getAttribute("href") === `#${entry.target.id}`));
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    links.forEach((l) => {
      const target = document.querySelector(l.getAttribute("href") ?? "");
      if (target) observer.observe(target);
    });
  });
</script>

<script>
  // Principles carousel: dots, arrows, swipe, gentle auto-advance until touched.
  document.addEventListener("DOMContentLoaded", () => {
    const box = document.getElementById("principles");
    if (!box) return;
    const slides = Array.from(box.querySelectorAll<HTMLElement>(".pr-slide"));
    const dots = Array.from(box.querySelectorAll<HTMLButtonElement>(".pr-dot"));
    const bar = box.querySelector<HTMLElement>(".pr-progress i");
    let index = 0;
    let timer: number | undefined;
    const go = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("on", i === index));
      dots.forEach((d, i) => { d.classList.toggle("on", i === index); d.setAttribute("aria-selected", String(i === index)); });
      if (bar) { bar.style.animation = "none"; void bar.offsetWidth; bar.style.animation = ""; }
    };
    const stop = () => { window.clearInterval(timer); box.classList.add("paused"); };
    dots.forEach((d) => d.addEventListener("click", () => { stop(); go(Number(d.dataset.i)); }));
    box.querySelectorAll<HTMLButtonElement>(".pr-nav").forEach((b) => b.addEventListener("click", () => { stop(); go(index + Number(b.dataset.dir)); }));
    let startX = 0;
    box.addEventListener("pointerdown", (e) => { startX = e.clientX; });
    box.addEventListener("pointerup", (e) => { const dx = e.clientX - startX; if (Math.abs(dx) > 50) { stop(); go(index + (dx < 0 ? 1 : -1)); } });
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      timer = window.setInterval(() => { if (!box.classList.contains("hovering")) go(index + 1); }, 6000);
      box.addEventListener("mouseenter", () => box.classList.add("hovering"));
      box.addEventListener("mouseleave", () => box.classList.remove("hovering"));
    }
  });
</script>
