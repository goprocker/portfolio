          {developer.quote && <blockquote class="os-serif mt-5 border-l-2 border-[var(--blue)] pl-4 text-xl text-[var(--blue)]">{developer.quote}</blockquote>}
          <div class="mt-auto flex flex-wrap gap-2 pt-6 text-xs">
