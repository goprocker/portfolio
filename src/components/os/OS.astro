          <span class="status-pill glass"><span class="live"></span>available for new projects</span>
          <h2 class="win-h mt-5">Have something worth <span class="os-serif">building?</span></h2>
          <p class="mt-4 text-[var(--ink-2)]">Products, freelance work, hackathon teams, or a good argument about AI. My inbox is open — I usually reply within a day.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href={`mailto:${developer.email}`} class="pill pill-blue">{developer.email}</a>
            <a href={developer.linkedin} target="_blank" rel="noopener noreferrer" class="pill">LinkedIn ↗</a>
            <a href={developer.twitter} target="_blank" rel="noopener noreferrer" class="pill">X ↗</a>
            <a href={developer.instagram} target="_blank" rel="noopener noreferrer" class="pill">Instagram ↗</a>
            <a href={developer.website} target="_blank" rel="noopener noreferrer" class="pill">loopfound.in ↗</a>
          </div>
        </div>
        <form id="contact-form" data-recipient-email={developer.email} class="tile p-5 sm:p-6 lg:col-span-7" data-reveal>
          <div class="mail-field"><label>To</label><span class="text-[15px] text-[var(--ink)]">Gopinath R &lt;{developer.email}&gt;</span></div>
          <div class="mail-field"><label for="contact-name">From</label><input id="contact-name" name="name" type="text" required placeholder="Your name" /></div>
          <div class="mail-field"><label for="contact-email">Reply-to</label><input id="contact-email" name="email" type="email" required placeholder="you@company.com" /></div>
          <div class="mail-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required rows="5" placeholder="Tell me about the role, project or idea…"></textarea></div>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
            <span id="form-status" class="hidden text-xs font-bold"></span>
            <button id="contact-submit-btn" type="submit" class="ob ob-primary ml-auto"><span id="btn-text">Send message →</span></button>
          </div>
        </form>
      </div>
    </Win>
  </main>

  <footer class="os-wrap flex flex-wrap items-center justify-between gap-4 pt-6 pb-28 text-xs text-[var(--muted)]">
    <span class="os-mono">goprOS v1 · © {new Date().getFullYear()} Gopinath R · Chennai</span>
    <span class="flex gap-4">
      <a href={developer.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">GitHub</a>
      <a href={developer.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)]">LinkedIn</a>
      <a href="/terminal" class="hover:text-[var(--ink)]">Terminal</a>
    </span>
  </footer>
</div>

<script>
  import confetti from "canvas-confetti";
  import { playSuccessSound } from "../../utils/sound";
  import { PORTFOLIO_DATA } from "../../data/portfolio";
  import { fetchGitHubStats, timeAgo } from "../../utils/github";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusMsg = document.getElementById("form-status");
    const submitBtn = document.getElementById(
      "contact-submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const recipientEmail = PORTFOLIO_DATA.developer.email;

    // Fetch and populate live GitHub stats
    initGitHubStats();

    // "Currently building": the repos pushed most recently, straight from GitHub.
    function renderNowLive(stats: NonNullable<Awaited<ReturnType<typeof fetchGitHubStats>>>) {
      const box = document.getElementById("now-live");
      if (!box) return;
      // When a repo has no GitHub "About", fall back to the portfolio's own project blurb.
      const blurbs = new Map(PORTFOLIO_DATA.collabs.filter((c) => c.repo).map((c) => [c.repo!.split("/").pop()!.toLowerCase(), c.description.split(/(?<=\.)\s/)[0]]));
      const about = (r: { name: string; description: string }) =>
        r.description && r.description !== "No description provided" ? r.description : blurbs.get(r.name.toLowerCase()) ?? "";
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);
      const active = stats.featuredRepos.filter((r) => r.name.toLowerCase() !== "portfolio");
      const repos = active.slice(0, 4);
      if (!repos.length) { box.innerHTML = ""; return; }

      // The next four most recently pushed repos.
      // Hero widget + notch follow the same live list.
      const widget = document.getElementById("widget-now");
      if (widget) {
        widget.innerHTML = active.slice(0, 5).map((r) => `<li class="flex items-center justify-between gap-3"><a href="${r.url}" target="_blank" rel="noopener noreferrer" class="truncate font-medium text-[var(--ink)] hover:text-[var(--blue)]">${esc(r.name)}</a><span class="os-mono shrink-0 text-[11px] text-[var(--muted)]">${timeAgo(r.pushedAt)}</span></li>`).join("");
      }
      const notchBuilding = document.querySelectorAll<HTMLElement>(".notch-msg span")[1];
      if (notchBuilding) notchBuilding.textContent = `Building ${repos[0].name}`;

      const bench = document.getElementById("now-bench");
      if (bench) {
        const next = active.slice(4, 8);
        bench.innerHTML = next.length
          ? next.map((r) => `<a href="${r.url}" target="_blank" rel="noopener noreferrer" class="tile now-card group block !min-h-0 p-4" data-spot>
              <div class="flex items-center justify-between gap-2"><h3 class="truncate font-bold tracking-tight text-[var(--ink)]">${esc(r.name)}</h3><span class="text-[var(--muted)] group-hover:text-[var(--blue)]">↗</span></div>
              <p class="mt-1 truncate text-sm text-[var(--ink-2)]">${esc(about(r)) || "Work in progress."}</p>
              <p class="os-mono mt-2 flex justify-between text-[11px] text-[var(--muted)]"><span>${esc(r.language)}</span><span>pushed ${timeAgo(r.pushedAt)}</span></p>
            </a>`).join("")
          : "";
      }
      box.innerHTML = repos.map((r) => {
        const days = Math.floor((Date.now() - Date.parse(r.pushedAt)) / 86_400_000);
        const heat = Math.max(8, 100 - days * 6);
        const fresh = days <= 3;
        return `<a href="${r.url}" target="_blank" rel="noopener noreferrer" class="tile now-card group flex flex-col p-5" data-spot>
          <div class="flex items-center justify-between gap-2">
            <span class="pill ${fresh ? "pill-mint" : "pill-blue"}">${fresh ? '<span class="live !h-1.5 !w-1.5"></span>' : ""}pushed ${timeAgo(r.pushedAt)}</span>
            <span class="text-[var(--muted)] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </div>
          <h3 class="mt-5 text-xl font-bold tracking-tight text-[var(--ink)]">${esc(r.name)}</h3>
          <p class="mt-1 line-clamp-2 text-sm text-[var(--ink-2)]">${esc(about(r)) || "Work in progress."}</p>
          <div class="mt-auto pt-4">
            <div class="flex items-center justify-between text-[11px] text-[var(--muted)]"><span class="os-mono">${esc(r.language)}</span><span class="os-mono">★ ${r.stars}</span></div>
            <div class="heat mt-2"><i style="width:${heat}%"></i></div>
          </div>
        </a>`;
      }).join("");
    }

    // Project cards with a repo get live stars + last-push time.
    function decorateProjects(stats: NonNullable<Awaited<ReturnType<typeof fetchGitHubStats>>>) {
      document.querySelectorAll<HTMLElement>("[data-repo]").forEach((card) => {
        const info = stats.repoIndex[card.dataset.repo ?? ""];
        const meta = card.querySelector<HTMLElement>(".live-meta");
        if (!info || !meta) return;
        meta.textContent = `${info.stars ? `★ ${info.stars} · ` : ""}pushed ${timeAgo(info.pushedAt)}`;
        meta.classList.add("text-[var(--blue)]");
      });
    }

    async function initGitHubStats() {
      const loadingEl = document.getElementById("gui-gh-loading");
      const contentEl = document.getElementById("gui-gh-content");
      const starsEl = document.getElementById("gui-gh-stars");
      const forksEl = document.getElementById("gui-gh-forks");
      const reposEl = document.getElementById("gui-gh-repos");
      const followersEl = document.getElementById("gui-gh-followers");
      const langListEl = document.getElementById("gui-gh-lang-list");
      const reposListEl = document.getElementById("gui-gh-repos-list");

      const stats = await fetchGitHubStats();
      if (!stats) {
        if (loadingEl) loadingEl.textContent = "GitHub metrics temporarily offline / rate-limited.";
        return;
      }

      renderNowLive(stats);
      decorateProjects(stats);
      if (loadingEl) loadingEl.classList.add("hidden");
      if (contentEl) contentEl.classList.remove("hidden");

      if (starsEl) starsEl.textContent = String(stats.totalStars);
      if (forksEl) forksEl.textContent = String(stats.totalForks);
      if (reposEl) reposEl.textContent = String(stats.publicRepos);
      if (followersEl) followersEl.textContent = String(stats.followers);

      if (langListEl) {
        langListEl.innerHTML = "";
        stats.topLanguages.forEach((lang) => {
          const badge = document.createElement("span");
          badge.className = "px-2 py-1 bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--fg-bright)] flex items-center gap-1.5";
          badge.innerHTML = `<span class="text-[var(--accent)] font-bold">${lang.name}</span> <span class="text-[var(--fg-dim)] text-[10px]">(${lang.percentage}%)</span>`;
          langListEl.appendChild(badge);
        });
      }

      if (reposListEl) {
        reposListEl.innerHTML = "";
        stats.featuredRepos.slice(0, 6).forEach((repo) => {
          const card = document.createElement("a");
          card.href = repo.url;
          card.target = "_blank";
          card.rel = "noopener noreferrer";
          card.className = "border border-[var(--border-color)] bg-[var(--bg-main)] p-3 hover:border-[var(--accent)] transition-all flex flex-col justify-between block group";
          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-[var(--border-color)] pb-1.5 mb-1.5">
                <span class="text-xs font-bold text-[var(--fg-bright)] group-hover:text-[var(--accent)] truncate">📦 ${repo.name}</span>
                <span class="text-[10px] text-[var(--accent)] font-bold shrink-0">⭐ ${repo.stars}</span>
              </div>
              <p class="text-[11px] text-[var(--fg-dim)] line-clamp-2 leading-tight">${repo.description}</p>
            </div>
            <div class="flex flex-wrap items-center justify-between text-[10px] text-[var(--fg-dim)] pt-2 mt-2 border-t border-[var(--border-color)] gap-1">
              <span class="font-bold text-[var(--violet)]">${repo.language}</span>
              <span class="truncate">Updated ${repo.updatedAt} ↗</span>
            </div>
          `;
          reposListEl.appendChild(card);
        });
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById(
        "contact-name",
      ) as HTMLInputElement;
      const emailInput = document.getElementById(
        "contact-email",
      ) as HTMLInputElement;
      const messageInput = document.getElementById(
        "contact-message",
      ) as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();

      if (!name || !email || !message) return;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Sending…";
      if (statusMsg) {
        statusMsg.className = "text-xs font-bold text-yellow-400 block";
        statusMsg.textContent = "Sending your message…";
      }

      try {
        const response = await fetch(
          `https://formsubmit.co/ajax/${recipientEmail}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              name,
              email,
              message,
              _subject: `Portfolio Contact from ${name}`,
              _captcha: "false",
            }),
          },
        );

        if (response.ok) {
          playSuccessSound();

          confetti({
            particleCount: 80,
            spread: 60,
            origin: { y: 0.7 },
            colors: ["#00ff66", "#00f0ff", "#ffb000", "#bd93f9"],
          });

          if (statusMsg) {
            statusMsg.className = "text-xs font-bold text-emerald-400 block";
            statusMsg.textContent =
              "✓ Sent! I'll get back to you soon.";
            setTimeout(() => {
              statusMsg.className = "text-xs font-bold hidden";
              statusMsg.textContent = "";
            }, 7000);
          }
          form.reset();
        } else {
          throw new Error(`HTTP ${response.status}`);
        }
      } catch (err) {
        if (statusMsg) {
          statusMsg.className = "text-xs font-bold text-rose-400 block";
          statusMsg.textContent =
            "✖ Transmission failed. Please try again later.";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Send message →";
      }
    });

    const bindLaunchBtn = (id: string, callback: () => void) => {
      const el = document.getElementById(id);
      if (!el) return;
      let lastTrigger = 0;
      const handler = (e: Event) => {
        const now = Date.now();
        if (now - lastTrigger < 300) return; // Prevent double trigger
        lastTrigger = now;
        callback();
      };
      el.addEventListener("click", handler);
      el.addEventListener("touchstart", (e) => {
        e.preventDefault();
        handler(e);
      }, { passive: false });
    };

    bindLaunchBtn("gui-launch-pong", () => {
      const win = window as unknown as { togglePong?: (f?: boolean) => void };
      if (win.togglePong) {
        win.togglePong(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-snake", () => {
      const win = window as unknown as { toggleSnake?: (f?: boolean) => void };
      if (win.toggleSnake) {
        win.toggleSnake(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-radio", () => {
      const win = window as unknown as { radioEngine?: { toggleModal: (f?: boolean) => void } };
      if (win.radioEngine) {
        win.radioEngine.toggleModal(true);
        playSuccessSound();
      }
    });
  });
</script>

<script>
  // Experience tabs
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[role='tab'][id^='xp-tab-']"));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = tabs[(i + (e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next);
      });
    });

    document.getElementById("gui-launch-matrix")?.addEventListener("click", () => {
      (window as unknown as { toggleMatrix?: (f?: boolean) => void }).toggleMatrix?.(true);
    });
  });
</script>

<script>
  // goprOS: notch, theme, draggable widgets, active dock icon.
  document.addEventListener("DOMContentLoaded", () => {
    const os = document.querySelector<HTMLElement>(".os");
    if (!os) return;

    // Theme: remember choice, default to system preference.
    let saved: string | null = null;
    try { saved = localStorage.getItem("goopros_mode"); } catch {}
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    os.dataset.mode = saved ?? (prefersDark ? "dark" : "light");
    document.getElementById("mode-toggle")?.addEventListener("click", (e) => {
      e.stopPropagation();
      os.dataset.mode = os.dataset.mode === "dark" ? "light" : "dark";
      try { localStorage.setItem("goopros_mode", os.dataset.mode); } catch {}
    });

    // Notch: clock, rotating status, expand on hover/tap.
    const notch = document.getElementById("notch");
    const clock = document.getElementById("notch-clock");
    const tickClock = () => {
      if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    };
    tickClock();
    setInterval(tickClock, 15000);

    const msgs = Array.from(document.querySelectorAll<HTMLElement>(".notch-msg span"));
    let current = 0;
    setInterval(() => {
      if (notch?.classList.contains("open") || msgs.length < 2) return;
      const prev = msgs[current];
      current = (current + 1) % msgs.length;
      prev.classList.remove("on");
      prev.classList.add("off");
      msgs[current].classList.remove("off");
      msgs[current].classList.add("on");
      setTimeout(() => prev.classList.remove("off"), 600);
    }, 3200);

    const setOpen = (open: boolean) => {
      notch?.classList.toggle("open", open);
      notch?.setAttribute("aria-expanded", String(open));
    };
    if (notch) {
      const canHover = window.matchMedia("(hover: hover)").matches;
      if (canHover) {
        notch.addEventListener("mouseenter", () => setOpen(true));
        notch.parentElement?.addEventListener("mouseleave", () => setOpen(false));
      }
      notch.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a, button")) return;
        setOpen(!notch.classList.contains("open"));
      });
      notch.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); setOpen(!notch.classList.contains("open")); }
        if (e.key === "Escape") setOpen(false);
      });
      notch.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("click", (e) => { if (!notch.contains(e.target as Node)) setOpen(false); });
    }

    // Draggable widgets (desktop layout only).
    const desktop = window.matchMedia("(min-width: 1024px)");
    let z = 10;
    document.querySelectorAll<HTMLElement>("[data-widget]").forEach((widget) => {
      const handle = widget.querySelector<HTMLElement>(".widget-head");
      if (!handle) return;
      let startX = 0, startY = 0, baseX = 0, baseY = 0, dragging = false;
      handle.addEventListener("pointerdown", (e) => {
        if (!desktop.matches) return;
        dragging = true;
        widget.classList.add("dragging");
        widget.style.zIndex = String(++z);
        startX = e.clientX; startY = e.clientY;
        baseX = parseFloat(widget.dataset.x ?? "0");
        baseY = parseFloat(widget.dataset.y ?? "0");
        handle.setPointerCapture(e.pointerId);
      });
      handle.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const x = baseX + e.clientX - startX;
        const y = baseY + e.clientY - startY;
        widget.dataset.x = String(x);
        widget.dataset.y = String(y);
        widget.style.translate = `${x}px ${y}px`;
      });
      const end = () => { dragging = false; widget.classList.remove("dragging"); };
      handle.addEventListener("pointerup", end);
      handle.addEventListener("pointercancel", end);
    });

    // Dock: mark the app for the section in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".dock a.dock-link"));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) => l.classList.toggle("active", l.getAttribute("href") === `#${entry.target.id}`));
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    links.forEach((l) => {
      const target = document.querySelector(l.getAttribute("href") ?? "");
      if (target) observer.observe(target);
    });
  });
</script>

<script>
  // Principles carousel: dots, arrows, swipe, gentle auto-advance until touched.
  document.addEventListener("DOMContentLoaded", () => {
    const box = document.getElementById("principles");
    if (!box) return;
    const slides = Array.from(box.querySelectorAll<HTMLElement>(".pr-slide"));
    const dots = Array.from(box.querySelectorAll<HTMLButtonElement>(".pr-dot"));
    const bar = box.querySelector<HTMLElement>(".pr-progress i");
    let index = 0;
    let timer: number | undefined;
    const go = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("on", i === index));
      dots.forEach((d, i) => { d.classList.toggle("on", i === index); d.setAttribute("aria-selected", String(i === index)); });
      if (bar) { bar.style.animation = "none"; void bar.offsetWidth; bar.style.animation = ""; }
    };
    const stop = () => { window.clearInterval(timer); box.classList.add("paused"); };
    dots.forEach((d) => d.addEventListener("click", () => { stop(); go(Number(d.dataset.i)); }));
    box.querySelectorAll<HTMLButtonElement>(".pr-nav").forEach((b) => b.addEventListener("click", () => { stop(); go(index + Number(b.dataset.dir)); }));
    let startX = 0;
    box.addEventListener("pointerdown", (e) => { startX = e.clientX; });
    box.addEventListener("pointerup", (e) => { const dx = e.clientX - startX; if (Math.abs(dx) > 50) { stop(); go(index + (dx < 0 ? 1 : -1)); } });
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      timer = window.setInterval(() => { if (!box.classList.contains("hovering")) go(index + 1); }, 6000);
      box.addEventListener("mouseenter", () => box.classList.add("hovering"));
      box.addEventListener("mouseleave", () => box.classList.remove("hovering"));
    }
  });
</script>
