          <div class="pr-stage relative mt-6 min-h-[190px] flex-1" aria-live="polite">
            {principles.map((p, i) => (
              <article class:list={["pr-slide", i === 0 && "on"]} data-i={i}>
                <span class="os-serif block text-6xl leading-none text-[var(--blue)]">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="mt-4 text-xl font-bold leading-snug tracking-tight text-[var(--ink)]">{p.title.charAt(0) + p.title.slice(1).toLowerCase()}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-[var(--ink-2)]">{p.description}</p>
