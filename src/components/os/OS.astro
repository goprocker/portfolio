    <!-- GITHUB -->
    <Win id="github" title="GitHub — live" icon="github">
      <Fragment slot="heading">In the <span class="os-serif">commits</span></Fragment>
      <div class="space-y-4">
        <div data-reveal><GitHubActivity /></div>
        <div id="gui-gh-loading" class="os-mono text-xs text-[var(--muted)]">Connecting to GitHub…</div>
        <div id="gui-gh-content" class="hidden space-y-4">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="tile p-4"><div class="text-xs text-[var(--muted)]">Stars</div><div id="gui-gh-stars" class="mt-1 text-3xl font-bold text-[var(--ink)]">0</div></div>
            <div class="tile p-4"><div class="text-xs text-[var(--muted)]">Forks</div><div id="gui-gh-forks" class="mt-1 text-3xl font-bold text-[var(--ink)]">0</div></div>
            <div class="tile p-4"><div class="text-xs text-[var(--muted)]">Public repos</div><div id="gui-gh-repos" class="mt-1 text-3xl font-bold text-[var(--ink)]">0</div></div>
            <div class="tile p-4"><div class="text-xs text-[var(--muted)]">Followers</div><div id="gui-gh-followers" class="mt-1 text-3xl font-bold text-[var(--ink)]">0</div></div>
          </div>
          <div class="tile p-4"><div class="mb-3 text-xs text-[var(--muted)]">Primary languages</div><div id="gui-gh-lang-list" class="os-mono flex flex-wrap gap-2 text-xs"></div></div>
          <p class="os-mono pt-2 text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]">Recently pushed · live from GitHub</p>
          <div id="gui-gh-repos-list" class="os-mono grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
        </div>
      </div>
    </Win>

    <!-- OFF THE CLOCK -->
    <Win id="offclock" title="Off the clock" icon="music">
      <Fragment slot="heading">When I'm <span class="os-serif">not</span> shipping</Fragment>
      <div class="grid gap-4 md:grid-cols-3">
        <div data-reveal><SpotifyWidget /></div>
        <div data-reveal><GamesWidget /></div>
        <div class="tile flex flex-col gap-3 p-5" data-reveal>
          <h3 class="font-bold text-[var(--ink)]">Playground</h3>
          <p class="text-sm text-[var(--muted)]">Little things hidden in this site.</p>
          <div class="mt-auto grid grid-cols-2 gap-2">
            <button type="button" id="gui-launch-pong" class="ob justify-center !px-2">Pong</button>
            <button type="button" id="gui-launch-snake" class="ob justify-center !px-2">Snake</button>
            <button type="button" id="gui-launch-radio" class="ob justify-center !px-2">Radio</button>
            <button type="button" id="gui-launch-matrix" class="ob justify-center !px-2">Matrix</button>
