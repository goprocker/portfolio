---
import "../styles/os.css";
import Layout from "../layouts/Layout.astro";
import AppIcon from "../components/os/AppIcon.astro";
---

<Layout title="404 — Gopinath R" description="This page doesn't exist.">
  <div class="os grid min-h-screen place-items-center p-4" data-site>
    <div class="wallpaper" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="win glass w-full max-w-md" data-boot>
      <div class="win-bar">
        <span class="win-title"><AppIcon name="work" size={20} />Finder</span>
        <span class="win-ctl" aria-hidden="true"><span>—</span><span>▢</span><span>✕</span></span>
      </div>
      <div class="win-body text-center">
        <p class="os-serif text-7xl leading-none text-[var(--blue)]">404</p>
        <h1 class="mt-4 text-2xl font-bold tracking-tight text-[var(--ink)]">This file isn't on the desktop.</h1>
        <p class="mt-2 text-sm text-[var(--muted)]">
          <span class="os-mono" id="missing-path">this page</span> was moved, renamed, or never shipped.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/" class="ob ob-primary">Back to desktop</a>
          <a href="/#work" class="ob">See projects</a>
          <a href="/terminal" class="ob">Terminal</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const path = document.getElementById("missing-path");
  if (path) path.textContent = location.pathname;
  try {
    const mode = localStorage.getItem("goopros_mode");
    const os = document.querySelector<HTMLElement>(".os");
    if (os) os.dataset.mode = mode ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  } catch {}
</script>
