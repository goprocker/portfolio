---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { site } from "../data/site";
---

<Layout title="Contact" description={`Get in touch with ${site.name} for design and development projects.`}>
  <section class="px-6 pt-16 pb-24">
    <div class="max-w-4xl mx-auto">
      <ScrollReveal>
        <p class="text-accent text-sm font-medium tracking-widest uppercase mb-4">
          Contact
        </p>
        <h1 class="font-display text-4xl sm:text-5xl font-extrabold mb-4">
          Let's work together
        </h1>
        <p class="text-text-muted text-lg max-w-xl mb-12">
          Have a project in mind or just want to say hello? Fill out the form
          below and I'll get back to you.
        </p>
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <ScrollReveal delay={1} class="lg:col-span-3">
          <ContactForm />
        </ScrollReveal>

        <ScrollReveal delay={2} class="lg:col-span-2">
          <div class="space-y-8">
            <div>
              <h3 class="font-display font-bold mb-2">Email</h3>
              <a
                href={`mailto:${site.email}`}
                class="text-accent hover:underline"
              >
                {site.email}
              </a>
            </div>
            <div>
              <h3 class="font-display font-bold mb-4">Social</h3>
              <div class="space-y-3">
                <a
                  href={site.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-text-muted hover:text-accent transition-colors text-sm"
                >
                  GitHub
                </a>
                <a
                  href={site.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-text-muted hover:text-accent transition-colors text-sm"
                >
                  LinkedIn
                </a>
                <a
                  href={site.social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-text-muted hover:text-accent transition-colors text-sm"
                >
                  Twitter / X
                </a>
                <a
                  href={site.social.dribbble}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-text-muted hover:text-accent transition-colors text-sm"
                >
                  Dribbble
                </a>
              </div>
            </div>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>
</Layout>
