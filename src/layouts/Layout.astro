---
import "../styles/global.css";
import MatrixRain from "../components/MatrixRain.astro";
import PongGame from "../components/PongGame.astro";
import SnakeGame from "../components/SnakeGame.astro";
import RadioPlayer from "../components/RadioPlayer.astro";
import ScrollEffects from "../components/ScrollEffects.astro";
import { PORTFOLIO_DATA } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  variant?: "terminal" | "site";
}

const {
  title = `${PORTFOLIO_DATA.developer.name} // TUI Portfolio`,
  description = PORTFOLIO_DATA.developer.bio,
  variant = "terminal",
} = Astro.props;
const isSite = variant === "site";
---

<!DOCTYPE html>
<html lang="en" data-theme="green">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta name="theme-color" content={isSite ? "#0a0a0b" : "#0a120b"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <script>
      import { applyTheme } from "../config/themeConfig";
      const savedTheme = localStorage.getItem("tui_theme") || "green";
      applyTheme(savedTheme);
    </script>
  </head>
  <body
    class:list={["min-h-screen relative flex flex-col justify-between p-0", isSite ? "site-body" : "crt-flicker"]}
  >
    {!isSite && <div id="crt-overlay-layer" class="crt-overlay"></div>}
    {!isSite && <div class="crt-vignette"></div>}

    <MatrixRain />
    <PongGame />
    <SnakeGame />
    <RadioPlayer />
    <ScrollEffects />

    <div class="w-full my-auto z-10">
      <slot />
    </div>
  </body>
</html>
